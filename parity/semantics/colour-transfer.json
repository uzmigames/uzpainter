    {
      "entry_id": "uniform-colour-srgb8-store",
      "subject": "Uniform colour stored on an sRGB8 channel (legacy colour management)",
      "status": "exact",
      "formula": "Each component v taken as linear and stored as the code k with the largest float32 threshold t_k <= v (t_0 = 0): the GPU's float-to-sRGB8 conversion, which differs from round(255 encode_IEC(v)) on 2936 of the 65536 16-bit operands. The thresholds are the D3D12 RGBA8_UNORM_SRGB conversions of the GPU the goldens were recorded on (NVIDIA GeForce RTX 4090), measured by `uzp-evaluator-tests srgb8-hardware` (store: the smallest float32 of each code, by bisection over clears of an sRGB render target; decode: a shader load of each code) and embedded in src/evaluator/arith.cpp; each lies within 0.15 code of decode_IEC((k - 0.5) / 255). sRGB, Working and Raw give the same codes.",
      "public_sources": [
        {
          "source_id": "S-SRGB",
          "locator": "IEC 61966-2-1:1999 §5.2-5.3 (transfer functions)"
        },
        {
          "source_id": "X-D3D12",
          "locator": "Data conversion rules: FLOAT to SRGB, SRGB to FLOAT (UNORM_SRGB)"
        },
        {
          "source_id": "A-PYDOC",
          "locator": "layerstack: ColorSpace of uniform colour and bitmap sources"
        }
      ],
      "parameters": [
        {
          "name": "threshold_count",
          "value": 255,
          "origin": "fitted"
        },
        {
          "name": "threshold_mantissa_bits_max",
          "value": 11,
          "origin": "fitted",
          "unit": "bits"
        }
      ],
