     "locator": "display.Camera"
    }
   ],
   "parameters": [
    {
     "name": "filter",
     "value": "box",
     "origin": "fitted"
    }
   ],
   "residuals": [],
   "notes": "Edge band mean |delta| per golden: neutral-grey-diffuse 459; plane-mid-grey 316; cube-mid-grey 942 (16-bit codes, 256 samples)."
  },
  {
   "entry_id": "channel-quantisation",
   "subject": "Material channels as stored by Painter and read by the shader",
   "status": "calibrated",
   "formula": "BaseColor: sRGB8 code = floor(255 c + 1/2) of the sRGB value c, decoded by IEC 61966-2-1; BaseMetalness and SpecularRoughness: L8 UNORM (truncate to 12 fractional bits, nearest, ties down), read as code / 255.",
   "public_sources": [
    {
     "source_id": "S-SRGB",
     "locator": "decoding"
    },
    {
     "source_id": "X-D3D12",
     "locator": "FLOAT to UNORM conversion"
    }
   ],
   "parameters": [
    {
     "name": "srgb8_ties",
     "value": "up",
     "origin": "fitted"
    }
   ],
   "residuals": [],
   "notes": "The tie rule of sRGB 0.5 and 0.9 was chosen on the mirror sphere (code 230 fits better than 229); the L8 rule is Tier 0's (quantisation-profile.json)."
  },
  {
   "entry_id": "metal-lobe",
   "subject": "open-pbr base at metalness 1 (default shader, decision 042)",
   "status": "calibrated",
   "formula": "f = F_schlick(o.h; F0 = base colour) D_GGX G2 / (4 cos_o cos_i) + F0 (1 - E1(mu_o)) (1 - E1(mu_i)) / (pi (1 - E1_avg)); alpha = roughness^2; G2 height-correlated Smith; E1 the lobe's albedo with F = 1 (tabulated). The multiple-scattering lobe is tinted by F0 (MDL multiscatter_tint).",
