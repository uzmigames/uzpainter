      "subject": "AO_Mixed: the baked ambient occlusion mesh map mixed with the AO channel",
      "status": "gap",
      "formula": "Release gap (decision 086): no exact Tier 0 golden yet (recording R-086); a configuration naming it is refused with NotYetSupported before anything is written.",
      "public_sources": [
        {
          "source_id": "A-PYDOC",
          "locator": "substance_painter.export: Full json_config dict possibilities, srcMapType virtualMap"
