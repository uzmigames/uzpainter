{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uzpainter:parity:schema:exceptions:1",
  "title": "UzPainter parity exception register",
  "description": "Schema of parity/exceptions.json (parity/CONTRACT.md §5). Exact equality is the rule; an entry is the only way a non-zero difference passes. Each entry is owner-approved, versioned, backed by evidence and by a defect-detection test, and recorded as a decision under .rulebook/decisions/. Public: numbers and hashes of the private evidence only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": { "const": "uzpainter/parity/exceptions/1" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "metric": {
      "description": "A diagnostic of the comparison tool (CONTRACT.md §8.2). _downN is the same statistic after N x N box downsampling.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(max_abs_diff|mean_abs_diff|p99_abs_diff|differing_count|differing_percent)(_down(2|4|8))?$"
        },
        {
          "enum": [
            "normal_angular_max_deg",
            "normal_angular_mean_deg",
            "normal_non_finite_count",
            "normal_unnormalised_count",
            "id_label_differing_count",
            "alpha_differing_count",
            "edge_coverage_differing_count",
            "abs_mean_signed_diff_in_se",
            "compression_max_abs_diff"
          ]
        }
      ]
    },
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "scope", "max"],
      "properties": {
        "metric": { "$ref": "#/$defs/metric" },
        "scope": {
          "description": "whole: the statistic over the compared data; each_region: the statistic of every material region; covered: the statistic over the texels the comparison's UV coverage mask marks covered (decision 223); covered_interior: the statistic over the covered texels whose eight neighbours are all covered (x wrapping, tools/parity/coverage.py `distance_bands`), so without the island-edge texels (decision 395). The entry covers no comparison without such a mask, nor one whose mask has no texel in the scope.",
          "enum": ["whole", "each_region", "covered", "covered_interior"]
        },
        "max": {
          "description": "Inclusive upper bound: the metric passes when its value is <= max.",
          "type": "number",
          "minimum": 0
        },
        "excepted_outputs": {
          "description": "Decision 395: the recorded outputs of the entry's `goldens` (the private record's output ids, `Comparison.output_id`) this bound does not apply to. Every other comparison of the entry is held to it, a comparison that names no output included. Owner scope splits only.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exception_id",
        "version",
        "tier",
        "domain",
        "bounds",
        "evidence",
        "defect_detection_test",
        "decision_id",
        "approved_by",
        "approved_on"
      ],
      "properties": {
        "exception_id": { "type": "string", "pattern": "^EXC-[0-9]{3,}$" },
        "version": { "type": "integer", "minimum": 1 },
        "withdrawn": {
          "description": "Decision 259: this version withdraws its id. It repeats the terms withdrawn, its decision records the owner's withdrawal, and while it is the highest version nothing of the id is in force.",
          "const": true
        },
        "tier": { "enum": ["0", "1", "2a", "2b", "3"] },
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "selector"],
          "properties": {
            "kind": {
              "enum": [
                "channel",
                "asset_map",
                "procedural_asset",
                "bake_map",
                "render_fixture_class",
                "backend_pair",
                "production_export"
              ]
            },
            "selector": {
              "description": "The comparison domain covered, exactly as named by the public manifests (golden-public.json `domain`). For `production_export` (decision 414) it names the export path the entry lets production write; a comparison is in that domain only when its candidate's export receipt names the entry in `exceptions_relied_on` (`Comparison.candidate_exceptions`), whatever golden it is compared with.",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._:-]*(/[A-Za-z0-9][A-Za-z0-9._:-]*)*$"
            },
            "goldens": {
              "description": "Decision 307: the goldens of the domain this entry covers (their public manifests' `golden_id`); a comparison naming no listed golden is not covered. Absent: every golden of the domain.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)+$" }
            },
            "outputs": {
              "description": "Decision 307: the recorded outputs of the listed goldens this entry covers (the private record's output ids, e.g. `s5/basecolor/step46`); requires `goldens`. Absent: every output of the listed goldens.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "dependentRequired": { "outputs": ["goldens"] }
        },
        "bounds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bound" }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "summary", "private_evidence", "uncontrolled_settings"],
          "properties": {
            "basis": {
              "description": "owner_scope_split (decisions 223, 395): Painter is stable and the difference is UzPainter's unfitted rule, excepted by the owner's own scope decision outside the covered texels, and on the island-edge covered texels of the outputs a bound names in `excepted_outputs`.",
              "enum": ["oracle_instability", "irreducible_difference", "noise_floor", "owner_scope_split"]
            },
            "summary": { "type": "string", "minLength": 1 },
            "private_evidence": {
              "description": "SHA-256 of the private evidence records (stability reports, references, difference maps).",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sha256", "description"],
                "properties": {
                  "sha256": { "$ref": "#/$defs/sha256" },
                  "description": { "type": "string", "minLength": 1 }
                }
              }
            },
            "noise_floor": {
              "description": "Measured noise floor per metric (Tier 3): Iray's own error at S and UzPainter's error at S.",
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/metric" },
              "additionalProperties": { "type": "number", "minimum": 0 }
            },
            "uncontrolled_settings": {
              "description": "Every setting recorded `uncontrolled` in the references this entry relies on (empty when none).",
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "defect_detection_test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["test_id", "injected_defects", "outcome"],
          "properties": {
            "test_id": { "type": "string", "minLength": 1 },
            "injected_defects": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "outcome": {
              "description": "The bounds were applied to every injected defect and each one failed.",
              "const": "every_injected_defect_fails"
            },
            "report_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "decision_id": {
          "description": "The owner decision under .rulebook/decisions/ (three-digit number).",
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "approved_by": { "const": "owner" },
        "approved_on": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "description": "Tier 3: noise-floor evidence, render or backend domains only (never a structural difference), and the four render defect injections.",
          "if": { "properties": { "tier": { "const": "3" } } },
          "then": {
            "properties": {
              "domain": { "properties": { "kind": { "enum": ["render_fixture_class", "backend_pair"] } } },
              "bounds": {
                "items": {
                  "properties": {
                    "metric": {
                      "not": {
                        "enum": [
                          "id_label_differing_count",
                          "alpha_differing_count",
                          "edge_coverage_differing_count"
                        ]
                      }
                    }
                  }
                }
              },
              "defect_detection_test": {
                "properties": {
                  "injected_defects": {
                    "allOf": [
                      { "contains": { "const": "missing_channel" } },
                      { "contains": { "const": "wrong_lobe" } },
                      { "contains": { "const": "roughness_offset" } },
                      { "contains": { "const": "wrong_environment_rotation" } }
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "domain": {
                "properties": {
                  "kind": {
                    "enum": ["channel", "asset_map", "procedural_asset", "bake_map", "backend_pair", "production_export"]
                  }
                }
              },
              "evidence": {
                "properties": {
                  "basis": { "enum": ["oracle_instability", "irreducible_difference", "owner_scope_split"] }
                }
              },
              "bounds": {
                "items": {
                  "properties": {
                    "metric": {
                      "description": "Downsampled statistics are render diagnostics (Tier 3 only).",
                      "not": { "type": "string", "pattern": "_down(2|4|8)$" }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "description": "An owner scope split (decisions 223, 395) bounds only the covered texels, and holds them exactly equal: the texels outside the coverage are the ones it excepts. One of its bounds is max |delta| 0 on every comparison (no `excepted_outputs`); a bound that excepts outputs names the entry's goldens' outputs.",
          "if": {
            "properties": { "evidence": { "properties": { "basis": { "const": "owner_scope_split" } } } }
          },
          "then": {
            "properties": {
              "bounds": {
                "items": { "properties": { "scope": { "enum": ["covered", "covered_interior"] } } },
                "contains": {
                  "properties": { "metric": { "const": "max_abs_diff" }, "max": { "const": 0 } },
                  "not": { "required": ["excepted_outputs"] }
                }
              }
            }
          },
          "else": {
            "properties": {
              "bounds": {
                "items": {
                  "properties": { "scope": { "enum": ["whole", "each_region"] } },
                  "not": { "required": ["excepted_outputs"] }
                }
              }
            }
          }
        },
        {
          "description": "Decision 414: a production export domain is the files a production export writes under the entry, named by their receipts, never some goldens or outputs; it is an owner scope split.",
          "if": {
            "properties": { "domain": { "properties": { "kind": { "const": "production_export" } } } }
          },
          "then": {
            "properties": {
              "domain": { "not": { "anyOf": [{ "required": ["goldens"] }, { "required": ["outputs"] }] } },
              "evidence": { "properties": { "basis": { "const": "owner_scope_split" } } }
            }
          }
        },
        {
          "description": "A render fixture class is covered only on the measured noise floor.",
          "if": {
            "properties": { "domain": { "properties": { "kind": { "const": "render_fixture_class" } } } }
          },
          "then": {
            "properties": {
              "evidence": {
                "required": ["noise_floor"],
                "properties": { "basis": { "const": "noise_floor" } }
              }
            }
          }
        }
      ]
    }
  }
}
