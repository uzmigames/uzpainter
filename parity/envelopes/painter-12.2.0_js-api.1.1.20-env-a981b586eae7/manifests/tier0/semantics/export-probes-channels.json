  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "grid2x2",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.resource.import_project_resource",
        "args": {
          "input": "field-a",
          "usage": "TEXTURE"
        }
      },
      {
        "step": 3,
        "call": "substance_painter.resource.import_project_resource",
        "args": {
          "input": "grey-a",
          "usage": "TEXTURE"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top",
          "texture_set": "s0"
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 4,
          "channels": [
            "BaseColor",
            "SpecularRoughness"
          ]
        }
      },
      {
        "step": 6,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 4,
          "channel": "BaseColor",
          "resource_step": 2,
          "color_space": "Raw"
        }
      },
      {
        "step": 7,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 4,
          "channel": "SpecularRoughness",
          "resource_step": 3
        }
      },
      {
        "step": 8,
        "call": "substance_painter.layerstack.Node.set_blending_mode",
        "args": {
          "node_step": 4,
          "blending_mode": "Normal",
          "channel": "BaseColor"
        }
      },
      {
        "step": 9,
        "call": "substance_painter.layerstack.Node.set_opacity",
        "args": {
          "node_step": 4,
          "opacity": 1.0,
          "channel": "BaseColor"
        }
      },
      {
        "step": 10,
        "call": "substance_painter.layerstack.Node.set_blending_mode",
        "args": {
          "node_step": 4,
          "blending_mode": "Normal",
          "channel": "SpecularRoughness"
        }
      },
      {
        "step": 11,
        "call": "substance_painter.layerstack.Node.set_opacity",
        "args": {
          "node_step": 4,
          "opacity": 1.0,
          "channel": "SpecularRoughness"
        }
      },
      {
        "step": 12,
        "call": "substance_painter.export.list_project_textures",
        "args": {
          "config": "probe-channels-p5-luminance"
        }
      },
      {
        "step": 13,
        "call": "substance_painter.export.list_project_textures",
        "args": {
          "config": "probe-channels-p6-alpha-of-roughness"
        }
      },
      {
        "step": 14,
        "call": "substance_painter.export.list_project_textures",
        "args": {
          "config": "probe-channels-p6-alpha-of-basecolor"
        }
      },
      {
        "step": 15,
        "call": "substance_painter.export.list_project_textures",
        "args": {
          "config": "probe-channels-p7-absent-alpha"
        }
      },
      {
        "step": 16,
        "call": "substance_painter.export.list_project_textures",
        "args": {
          "config": "probe-channels-p8-black-l"
        }
      },
      {
        "step": 17,
        "call": "substance_painter.export.list_project_textures",
        "args": {
          "config": "probe-channels-p8-black-rgb"
        }
      },
      {
        "step": 18,
        "call": "substance_painter.export.list_project_textures",
