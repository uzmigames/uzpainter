{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/semantics/base-values-default",
  "tier": "0",
  "domain": "tier0/stack/base-values",
  "description": "Stack base values (04 section 2 step 1): empty project on the authored plane created with no template (Painter's default), one channel added per ChannelFormat member, every documented document map requested with no layer in the stack.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.textureset.Stack.add_channel",
        "args": {
          "channel": "User0",
          "format": "sRGB8"
        }
      },
      {
        "step": 3,
        "call": "substance_painter.textureset.Stack.add_channel",
        "args": {
          "channel": "User1",
          "format": "RGB8"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.textureset.Stack.add_channel",
        "args": {
          "channel": "User2",
          "format": "RGB16"
        }
      },
      {
        "step": 5,
        "call": "substance_painter.textureset.Stack.add_channel",
        "args": {
          "channel": "User3",
          "format": "RGB16F"
        }
      },
      {
        "step": 6,
        "call": "substance_painter.textureset.Stack.add_channel",
        "args": {
          "channel": "User4",
          "format": "RGB32F"
        }
      },
      {
        "step": 7,
        "call": "substance_painter.textureset.Stack.add_channel",
        "args": {
          "channel": "User5",
          "format": "L8"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.textureset.Stack.add_channel",
        "args": {
          "channel": "User6",
          "format": "L16"
        }
      },
      {
        "step": 9,
        "call": "substance_painter.textureset.Stack.add_channel",
        "args": {
          "channel": "User7",
          "format": "L16F"
        }
      },
      {
        "step": 10,
        "call": "substance_painter.textureset.Stack.add_channel",
        "args": {
          "channel": "Scattering",
          "format": "L32F"
        }
      },
      {
        "step": 11,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB",
            "documentMap/height:RGB",
            "documentMap/specular:RGB",
            "documentMap/opacity:RGB",
            "documentMap/emissive:RGB",
            "documentMap/displacement:RGB",
            "documentMap/glossiness:RGB",
            "documentMap/roughness:RGB",
            "documentMap/anisotropylevel:RGB",
            "documentMap/anisotropyangle:RGB",
            "documentMap/user0:RGB",
            "documentMap/user1:RGB",
            "documentMap/user2:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "infinite",
          "dithering": false
        }
      },
      {
        "step": 12,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/transmissive:RGB",
            "documentMap/reflection:RGB",
            "documentMap/ior:RGB",
            "documentMap/metallic:RGB",
            "documentMap/normal:RGB",
            "documentMap/ambientOcclusion:RGB",
            "documentMap/diffuse:RGB",
            "documentMap/specularlevel:RGB",
            "documentMap/blendingmask:RGB",
            "documentMap/user5:L",
            "documentMap/user6:L"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "infinite",
          "dithering": false
        }
      },
      {
        "step": 13,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/user3:RGB",
            "documentMap/user4:RGB",
            "documentMap/user7:L",
            "documentMap/scattering:L"
          ],
          "file_format": "exr",
          "bit_depth": "32f",
          "padding": "infinite",
          "dithering": false
        }
      }
    ]
  },
  "applied_settings": [
    {
      "name": "project.normal_map_format",
      "value": "OpenGL",
      "applied_by": "recorder_api"
    },
