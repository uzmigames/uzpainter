      "sha256": "6bcaeedaa985d6b3f7648b231356904cfa7a3cde7aa2d6869dea7494f8e21931",
      "size_bytes": 34797
    },
    {
      "record_id": "oracle-environment",
      "kind": "oracle_environment_record",
      "sha256": "332ddce6024e25f9b84ec9ce03850aa0c52809a6ba64a43283ef0ef7cf1edd4b",
      "size_bytes": 402
    }
  ]
