        "step": 14,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 15,
        "call": "substance_painter.layerstack.Node.set_visible",
        "args": {
          "node_step": 3,
          "visible": true,
          "probe": true
        }
      },
      {
        "step": 16,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 17,
        "call": "substance_painter.layerstack.Node.set_blending_mode",
        "args": {
          "node_step": 3,
          "blending_mode": "Multiply",
          "channel": "BaseColor",
          "probe": true
        }
      },
      {
        "step": 18,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 19,
        "call": "substance_painter.layerstack.Node.set_blending_mode",
        "args": {
          "node_step": 3,
