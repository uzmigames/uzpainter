  "domain": "phase0/template-default-material",
  "description": "Template-default material of the qualification sphere (task phase0.9_render-reference-capture item 3.2, decision 063): the authored sphere created as the qualification job creates it (mesh only, every project setting Painter's default) in an OCIO session (Painter's substance config), no layer in the stack; the template's channels BaseColor, BaseMetalness, SpecularRoughness, Normal and Height exported (the 8-bit channels at PNG 16, the 16-bit float ones at OpenEXR 32f), padding infinite, no dithering. Recorded twice (same session; after save and reopen).",
  "inputs": [
    {
      "input_id": "sphere",
      "kind": "mesh",
      "path": "parity/fixtures/render-procedure/sphere.obj",
      "sha256": "037ae3ce625732e6a2e8f3873f7ff5ce76c58a78a9c14b66581a3bad9dd2f26c",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "sphere"
        }
      },
      {
        "step": 2,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB",
            "documentMap/basemetalness:L",
            "documentMap/specularroughness:L"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "infinite",
          "dithering": false
        }
      },
      {
        "step": 3,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/normal:RGB",
            "documentMap/height:L"
          ],
          "file_format": "exr",
          "bit_depth": "32f",
          "padding": "infinite",
          "dithering": false
        }
      }
    ]
  },
