    "phase0/normal-convention/plane-dome/opengl"
  ],
  "entries": [
    {
      "entry_id": "green-channel-opengl",
      "subject": "Green channel of Painter's baked tangent-space normal, Opengl normal map format (plane-dome pair, hit texels)",
      "status": "calibrated",
      "formula": "On the plane-dome pair the low frame is T = +u direction, B = +v direction (sign +1), N = the plane normal at every texel, so the baked value is the hit triangle's normal n expressed as t = (n.T, n.B, n.N). Encoding: code = floor(65535 (t / 2 + 1/2) + 1/2) per channel, RGB = (x, y, z); OpenGL: green encodes +y, i.e. +v (up in UV space).",
      "public_sources": [
        {
          "source_id": "S-GLTF",
          "locator": "Materials, additional textures: normalTexture (+X right, +Y up)"
        },
        {
          "source_id": "A-PYDOC",
          "locator": "substance_painter.project.NormalMapFormat"
        },
        {
          "source_id": "S-MIKK",
          "locator": "mikktspace.h: setTSpaceBasic, normal-map sampler"
        }
      ],
      "parameters": [
        {
          "name": "normal_map_format",
          "value": "opengl",
          "origin": "authored"
        },
        {
          "name": "expected_green_sign_towards_plus_v",
          "value": 1,
          "origin": "public_documentation"
        },
        {
          "name": "observed_green_sign_towards_plus_v",
          "value": 1,
          "origin": "fitted"
        }
      ],
