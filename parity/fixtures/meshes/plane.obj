# UzPainter parity fixture: plane, 20 cm square in the XZ plane, normal +Y, UVs 0..1.
# Authored by UzmiGames (Apache-2.0). Used by the Painter oracle recorder Tier 0 sample.
o uzp_plane
v -10.0 0.0 10.0
v 10.0 0.0 10.0
v 10.0 0.0 -10.0
v -10.0 0.0 -10.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 1.0 0.0
usemtl uzp_plane
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
