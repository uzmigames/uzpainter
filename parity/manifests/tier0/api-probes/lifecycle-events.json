{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/api-probes/lifecycle-events",
  "tier": "0",
  "domain": "tier0/api-probes/lifecycle-events",
  "description": "API probe: order of the project lifecycle events and the is_busy()/is_in_edition_state() transitions. Two cycles of create, save_as (Full), close, then open, save (Full), close; each phase records the events dispatched and the readiness states polled until it completes.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.event.Dispatcher.connect",
        "args": {
          "events": [
            "ProjectCreated",
            "ProjectOpened",
            "ProjectEditionEntered",
            "ProjectEditionLeft",
            "ProjectAboutToSave",
            "ProjectSaved",
            "ProjectAboutToClose",
            "ProjectClosed",
            "BusyStatusChanged"
          ]
        }
      },
      {
        "step": 2,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 3,
        "call": "substance_painter.project.save_as",
        "args": {
          "mode": "Full"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.project.close"
      },
      {
        "step": 5,
        "call": "substance_painter.project.open"
      },
      {
        "step": 6,
        "call": "substance_painter.project.save",
        "args": {
          "mode": "Full"
        }
      },
      {
        "step": 7,
        "call": "substance_painter.project.close"
      }
    ]
  },
  "applied_settings": [
    {
      "name": "project.normal_map_format",
      "value": "OpenGL",
      "applied_by": "recorder_api"
    },
    {
      "name": "texture_set.resolution",
      "value": 256,
      "unit": "px",
      "applied_by": "recorder_api"
    }
  ],
  "expectations": [],
  "software": {
    "painter": {
      "product": "Adobe Substance 3D Painter",
      "version": "12.1.0",
      "build_id": "12.1.0+js-api.1.1.20"
    },
    "uzpainter_build_hash": null
  },
  "private_records": [
    {
      "record_id": "golden-record",
      "kind": "private_oracle_record",
      "sha256": "37cd0024ff8655a899219a5ae7c12c0bb4f9c5f9e27d57bb8ed6e8215f1de9b0",
      "size_bytes": 9357
    }
  ]
}
