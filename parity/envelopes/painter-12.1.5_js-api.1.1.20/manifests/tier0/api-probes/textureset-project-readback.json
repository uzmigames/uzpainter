      "sha256": "c0c41d3c6ded5b9277f17d4dce7be61c2e12852cfca268c4644f0ab083b60bde",
      "size_bytes": 8096
    },
    {
      "record_id": "oracle-environment",
      "kind": "oracle_environment_record",
      "sha256": "56fab3aca35fb9c522325bc980e42dea92472cc2a2712e60869592dae13d7bac",
      "size_bytes": 402
    }
  ]
}
