      },
      {
        "step": 31,
        "call": "substance_painter.source.SourceUniformColor.set_color",
        "args": {
          "node_step": 4,
          "channel": "BaseColor",
          "color": [
            0.2,
            0.4,
            0.6
          ],
          "color_space": "Working",
          "probe": true
