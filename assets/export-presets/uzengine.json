        },
        {
          "destChannel": "A",
          "srcChannel": "L",
          "srcMapType": "documentMap",
          "srcMapName": "opacity"
        }
      ],
      "parameters": {
        "fileFormat": "png",
        "bitDepth": "16"
      }
    },
    {
      "fileName": "$textureSet_normal",
      "channels": [
        {
          "destChannel": "R",
          "srcChannel": "R",
          "srcMapType": "virtualMap",
          "srcMapName": "Normal_DirectX"
        },
        {
          "destChannel": "G",
          "srcChannel": "G",
          "srcMapType": "virtualMap",
          "srcMapName": "Normal_DirectX"
        },
        {
          "destChannel": "B",
          "srcChannel": "B",
          "srcMapType": "virtualMap",
          "srcMapName": "Normal_DirectX"
        }
      ],
      "parameters": {
        "fileFormat": "png",
        "bitDepth": "16"
      }
    },
    {
      "fileName": "$textureSet_orm",
      "channels": [
        {
          "destChannel": "R",
          "srcChannel": "L",
          "srcMapType": "virtualMap",
          "srcMapName": "AO_Mixed"
        },
        {
          "destChannel": "G",
          "srcChannel": "L",
          "srcMapType": "documentMap",
          "srcMapName": "roughness"
        },
        {
          "destChannel": "B",
          "srcChannel": "L",
          "srcMapType": "documentMap",
          "srcMapName": "metallic"
        }
      ],
      "parameters": {
        "fileFormat": "png",
        "bitDepth": "8"
      }
    },
    {
      "fileName": "canonical/$textureSet_orm",
      "channels": [
        {
          "destChannel": "R",
          "srcChannel": "L",
          "srcMapType": "virtualMap",
          "srcMapName": "AO_Mixed"
        },
        {
          "destChannel": "G",
          "srcChannel": "L",
          "srcMapType": "documentMap",
          "srcMapName": "roughness"
        },
        {
          "destChannel": "B",
          "srcChannel": "L",
