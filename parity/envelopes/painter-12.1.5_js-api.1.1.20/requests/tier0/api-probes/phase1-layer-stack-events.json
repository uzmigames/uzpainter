{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/api-probes/phase1-layer-stack-events",
  "tier": "0",
  "domain": "tier0/api-probes/phase1-layer-stack-events",
  "description": "API probe P21-E (decision 110 \u00a74): on the plane, with LayerStacksModelDataChanged connected, a fill (BaseColor uniform, black mask, a levels content effect), a bitmap fill below it and a fill with a white mask; then, in the first session and after save/reopen, each edit call decision 110 \u00a74 lists that the documented probe vocabulary reaches, as a probe step with the events it dispatched: insert_paint, insert_levels_effect, insert_compare_mask_effect, insert_color_selection_effect, insert_anchor_point_effect, set_visible, set_blending_mode, set_opacity, set_mask_background, enable_mask, remove_mask (the white mask, added again after), set_projection_mode, set_projection_parameters, set_symmetry_enabled, affected_channel, LevelsEffectNode.set_parameters, SourceUniformColor.set_color, reset_source, SourceBitmap.set_color_space and reset_color_space. instantiate and set_material_source need an instance source and a material resource and are not part of it.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    },
    {
      "input_id": "mask_left_half",
      "kind": "image",
      "path": "parity/fixtures/api-probes/mask-left-half.png",
      "sha256": "f5d8e7f1c0bc3b577833422141afee43682f1b1fe28696e51de48e3031ccc724",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0",
        "note": "16x16 8-bit grey: left half 255, right half 0."
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.event.Dispatcher.connect",
        "args": {
          "events": [
            "LayerStacksModelDataChanged",
            "BusyStatusChanged"
          ]
