    {
      "entry_id": "srgb8-export",
      "subject": "Export of an sRGB8 channel to a 16-bit PNG",
      "status": "exact",
      "formula": "export = UNORM16 write rule of d_c, d_c the linear value the GPU decodes from the sRGB8 code c (the D3D12 RGBA8_UNORM_SRGB conversions of the GPU the goldens were recorded on (NVIDIA GeForce RTX 4090), measured by `uzp-evaluator-tests srgb8-hardware` (store: the smallest float32 of each code, by bisection over clears of an sRGB render target; decode: a shader load of each code) and embedded in src/evaluator/arith.cpp); d_c lies within one unit in the 8th significant bit of decode_IEC(c / 255) rounded to 8 significant bits, and differs from it on 29 codes. The same d_c is the operand sRGB8 channels blend on.",
      "public_sources": [
        {
          "source_id": "S-SRGB",
          "locator": "IEC 61966-2-1:1999 §5.2-5.3 (transfer functions)"
        },
        {
          "source_id": "X-D3D12",
          "locator": "Data conversion rules: FLOAT to SRGB, SRGB to FLOAT (UNORM_SRGB)"
        },
        {
          "source_id": "A-HELP-EXPORT",
          "locator": "Export settings: bit depth, padding"
        }
      ],
      "parameters": [
        {
          "name": "decode_entries",
          "value": 256,
          "origin": "fitted"
        }
      ],
