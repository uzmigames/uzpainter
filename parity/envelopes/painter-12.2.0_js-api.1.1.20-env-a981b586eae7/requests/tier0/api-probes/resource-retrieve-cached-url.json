      {
        "step": 14,
        "call": "substance_painter.resource.ResourceID.from_project",
        "args": {
          "name": "mask_left_half",
          "version": "0000000000000000000000000000000000000000.image"
        }
      },
      {
        "step": 15,
        "call": "substance_painter.resource.Resource.retrieve",
        "args": {
