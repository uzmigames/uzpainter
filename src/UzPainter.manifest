<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- UzPainter.exe's application manifest (decision 252): one setting only. On Windows 11 24H2 and
     later, a process started without a console gets none, instead of a new console with a window;
     started from a console it still inherits that console. Earlier Windows ignore the setting. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <consoleAllocationPolicy xmlns="http://schemas.microsoft.com/SMI/2024/WindowsSettings">detached</consoleAllocationPolicy>
    </windowsSettings>
  </application>
</assembly>
