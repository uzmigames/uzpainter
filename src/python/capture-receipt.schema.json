{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uzpainter/capture-receipt/1",
  "title": "UzPainter capture receipt",
  "description": "The receipt of uzpainter.render.capture and of the worker's capture tool (src/python/capture.h; docs/architecture/07-preview-and-render-parity.md §5; decision 148), written beside the PNG as <stem>.receipt.json. Every member is always present; null where the mode has no such thing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "revision", "project_uuid", "evaluator_profile", "render_state_digest", "mode", "source",
    "encoding", "backend", "adapter", "driver", "samples", "seed", "camera", "size", "display_configuration",
    "environment", "visibility", "occlusion", "shadows", "hashes"
  ],
  "properties": {
    "schema": {"const": "uzpainter/capture-receipt/1"},
    "revision": {"type": "integer", "minimum": 1},
    "project_uuid": {"type": "string", "minLength": 1},
    "evaluator_profile": {"type": "string"},
    "render_state_digest": {"$ref": "#/$defs/sha256"},
    "mode": {"type": "string", "pattern": "^(painter_viewport|base_color|channel:.+|mask:[1-9][0-9]*)$"},
    "source": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "texture_set", "stack", "root_path"],
          "properties": {
            "type": {"enum": ["documentMap", "diagnosticMap"]},
            "name": {"type": "string", "minLength": 1},
            "texture_set": {"type": "string"},
            "stack": {"type": "string"},
            "root_path": {"type": "string"}
          }
        }
      ]
    },
    "encoding": {
      "type": "object",
      "required": ["png", "exr"],
      "properties": {
        "png": {"$ref": "#/$defs/file_encoding"},
        "exr": {"$ref": "#/$defs/file_encoding"},
        "padding": {"const": "passthrough"}
      }
    },
    "backend": {"enum": ["dx12", "vulkan", "cpu"]},
    "adapter": {"type": ["string", "null"]},
    "driver": {"type": ["string", "null"]},
    "samples": {"oneOf": [{"type": "null"}, {"const": 1}]},
    "seed": {"type": ["integer", "null"], "minimum": 0},
    "camera": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["source"],
          "properties": {"source": {"enum": ["argument", "default_camera", "fit"]}}
        }
      ]
    },
    "size": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
      "items": false,
      "minItems": 2
    },
    "environment": {
      "description": "The environment a painter_viewport capture is lit by: the project's, or with default true the installation's default (the shipped studio-small-09.exr) when the project names none, a non-parity preview (decision 212). Null for the diagnostic modes.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "default", "rotation", "exposure"],
          "properties": {
            "sha256": {"$ref": "#/$defs/sha256"},
            "default": {"type": "boolean"},
            "rotation": {"type": "number"},
            "exposure": {"type": "number"}
          }
        }
      ]
    },
    "visibility": {
      "description": "The self-occlusion of a painter_viewport capture (decision 251): its model and the visibility rays traced per hit for the diffuse and the specular term, also part of render_state_digest. Null for the diagnostic modes.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "diffuse_rays", "specular_rays"],
          "properties": {
            "model": {"const": "ray_traced_self_occlusion"},
            "diffuse_rays": {"type": "integer", "minimum": 0},
            "specular_rays": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "occlusion": {
      "description": "The AO of a painter_viewport capture (decision 257): the AO mesh map of each texture set applied inside the self-occlusion rays as the per-ray weight mu^k about the faded shading normal (mu = cos of the ray to it, k = 2 (1 - a) / a, a = 1 + ao_strength (ao - 1)), whose cosine-weighted mean is a, the painted AO channel not applied, no cavity term, and the albedo's painted occlusion compounded with it. Part of render_state_digest. Null for the diagnostic modes.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "ao_source", "ao_strength", "ao_channel", "axis", "cavity", "painted_occlusion"],
          "properties": {
            "model": {"const": "cosine_power_visibility"},
            "ao_source": {
              "description": "Per texture set, in texture set order: the AO mesh map with its image's SHA-256, or none (ao = 1).",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["texture_set", "source", "sha256"],
                "properties": {
                  "texture_set": {"type": "string"},
                  "source": {"enum": ["mesh_map", "none"]},
                  "sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}
                }
              }
            },
            "ao_strength": {"const": 1.0},
            "ao_channel": {"const": "not_applied"},
            "axis": {"const": "shading_normal_after_fade"},
            "cavity": {"type": "null"},
            "painted_occlusion": {"const": "may_compound"}
          }
        }
      ]
    },
    "shadows": {
      "description": "The display state's shadows flag as requested and its effect on a painter_viewport capture: none, the pass always traces its self-occlusion (decision 251). Outside render_state_digest. Null for the diagnostic modes.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "effect"],
          "properties": {
            "requested": {"type": "boolean"},
            "effect": {"const": "none in painter_viewport"}
          }
        }
      ]
    },
    "display_configuration": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "config_sha256", "view"],
          "properties": {
            "mode": {"const": "ocio"},
            "config_sha256": {"$ref": "#/$defs/sha256"},
            "view": {"const": "Default - sRGB"}
          }
        }
      ]
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["png", "exr"],
      "properties": {"png": {"$ref": "#/$defs/sha256"}, "exr": {"$ref": "#/$defs/sha256"}}
    },
    "files": {
      "description": "Returned with the receipt (absolute paths), never written into the receipt file.",
      "type": "object",
      "required": ["png", "exr", "receipt"]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_encoding": {
      "type": "object",
      "required": ["bit_depth", "layout"],
      "properties": {
        "bit_depth": {"enum": ["16", "16f", "32f"]},
        "layout": {"enum": ["L", "RGB"]},
        "content": {"enum": ["display_codes", "linear"]}
      }
    }
  }
}
