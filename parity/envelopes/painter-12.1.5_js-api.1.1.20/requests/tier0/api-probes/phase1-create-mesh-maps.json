        "args": {
          "usage": "Height"
        }
      },
      {
        "step": 7,
        "call": "substance_painter.textureset.TextureSet.get_mesh_map_resource",
        "args": {
          "usage": "ID"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.textureset.TextureSet.get_mesh_map_resource",
        "args": {
          "usage": "Normal"
        }
      },
      {
        "step": 9,
        "call": "substance_painter.textureset.TextureSet.get_mesh_map_resource",
        "args": {
          "usage": "Opacity"
        }
      },
      {
        "step": 10,
        "call": "substance_painter.textureset.TextureSet.get_mesh_map_resource",
