{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/api-probes/phase1-close-without-saving",
  "tier": "0",
  "domain": "tier0/api-probes/phase1-close-without-saving",
  "description": "API probe P21-G (decision 109): create the plane, a fill named 'uzp fill A', save_as; then, in the first session and after save/reopen: rename the fill 'uzp fill B', read its name and needs_saving(), close without saving and open the same file again (the fill found again at its place), then its name, needs_saving() and file_path(), with the lifecycle events.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.event.Dispatcher.connect",
        "args": {
          "events": [
            "ProjectOpened",
            "ProjectEditionEntered",
            "ProjectEditionLeft",
            "ProjectAboutToSave",
            "ProjectSaved",
            "ProjectAboutToClose",
            "ProjectClosed",
            "BusyStatusChanged"
          ]
        }
      },
      {
        "step": 3,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.layerstack.Node.set_name",
        "args": {
          "node_step": 3,
          "name": "uzp fill A"
        }
      },
      {
        "step": 5,
        "call": "substance_painter.project.save_as",
        "args": {
          "work_file": "close-without-saving.spp",
          "mode": "Full"
        }
      },
      {
        "step": 6,
        "call": "substance_painter.layerstack.Node.set_name",
        "args": {
          "node_step": 3,
          "name": "uzp fill B",
          "probe": true
        }
      },
      {
        "step": 7,
        "call": "substance_painter.layerstack.Node.get_name",
        "args": {
          "node_step": 3
        }
      },
      {
        "step": 8,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 9,
        "call": "substance_painter.project.close",
        "args": {
          "probe": true
        }
      },
      {
        "step": 10,
        "call": "substance_painter.project.open",
        "args": {
          "probe": true
        }
      },
      {
        "step": 11,
        "call": "substance_painter.layerstack.Node.get_name",
        "args": {
          "node_step": 3
        }
      },
      {
        "step": 12,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 13,
        "call": "substance_painter.project.file_path",
        "args": {}
      }
    ]
  },
  "applied_settings": [
    {
      "name": "project.normal_map_format",
      "value": "OpenGL",
      "applied_by": "recorder_api"
    },
    {
      "name": "texture_set.resolution",
      "value": 256,
      "unit": "px",
      "applied_by": "recorder_api"
    }
  ],
  "expectations": [],
  "software": {
    "painter": {
      "product": "Adobe Substance 3D Painter",
      "version": "12.1.5",
      "build_id": "12.1.5+js-api.1.1.20"
    },
    "uzpainter_build_hash": null
  },
  "private_records": []
}
