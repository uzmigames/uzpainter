          "channels": [
            "Height"
          ]
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 3,
          "channel": "Height",
          "resource_step": 2
        }
      },
      {
        "step": 6,
        "call": "substance_painter.layerstack.Node.set_blending_mode",
        "args": {
          "node_step": 3,
          "blending_mode": "Normal",
          "channel": "Height"
        }
      },
      {
        "step": 7,
        "call": "substance_painter.layerstack.Node.set_opacity",
        "args": {
          "node_step": 3,
          "opacity": 1.0,
          "channel": "Height"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "virtualMap/Normal_OpenGL:RGB",
            "virtualMap/Normal_DirectX:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "infinite",
          "dithering": false
        }
      },
      {
        "step": 9,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/height:L",
            "documentMap/normal:RGB"
          ],
          "file_format": "exr",
          "bit_depth": "32f",
          "padding": "infinite",
          "dithering": false
        }
      }
