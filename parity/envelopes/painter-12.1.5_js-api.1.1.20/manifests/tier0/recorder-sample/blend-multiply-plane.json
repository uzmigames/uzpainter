      "sha256": "caaf469bcbbce4d6c7467ceed0111e84f44cfffc1a8a5f48853eb68a086bfbd5",
      "size_bytes": 7081
    },
    {
      "record_id": "r1-uzp_plane-basecolor",
      "kind": "exported_map",
      "sha256": "818b5162e33d92a5e5e15c44c0461b25b599de24be286637c81e9128c5898f7c",
      "size_bytes": 1014
    },
    {
      "record_id": "r2-uzp_plane-basecolor",
      "kind": "exported_map",
      "sha256": "818b5162e33d92a5e5e15c44c0461b25b599de24be286637c81e9128c5898f7c",
      "size_bytes": 1014
    },
    {
      "record_id": "oracle-environment",
      "kind": "oracle_environment_record",
      "sha256": "56fab3aca35fb9c522325bc980e42dea92472cc2a2712e60869592dae13d7bac",
      "size_bytes": 402
    }
  ]
}
