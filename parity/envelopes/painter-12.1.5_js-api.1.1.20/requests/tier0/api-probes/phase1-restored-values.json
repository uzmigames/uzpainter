      {
        "step": 28,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 29,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "infinite",
          "dithering": false
