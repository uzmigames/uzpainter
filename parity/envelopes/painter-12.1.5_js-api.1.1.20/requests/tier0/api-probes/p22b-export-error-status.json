{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/api-probes/p22b-export-error-status",
  "tier": "0",
  "domain": "tier0/api-probes/p22b-export-error-status",
  "description": "API probe P22-B (decision 295): on the plane, with ExportTexturesAboutToStart and ExportTexturesEnded connected, export_project_textures of BaseColor at PNG 8 to an exportPath that a regular file in the recording's private directory occupies, so the export cannot write: the exception it raises and the status ExportTexturesEnded receives (documented: the result is never ExportStatus.Error, the event is), in the first session and after save and reopen.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.event.Dispatcher.connect",
        "args": {
          "events": [
            "ExportTexturesAboutToStart",
            "ExportTexturesEnded"
          ]
        }
      },
      {
        "step": 3,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB"
          ],
          "file_format": "png",
          "bit_depth": 8,
          "padding": "infinite",
          "dithering": false,
          "probe": true,
          "export_path_blocked": true
        }
      }
    ]
  },
  "applied_settings": [
    {
      "name": "project.normal_map_format",
      "value": "OpenGL",
