{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/api-probes/phase1-restored-values",
  "tier": "0",
  "domain": "tier0/api-probes/phase1-restored-values",
  "description": "API probe P22-C (decision 111): after save_as (Full), needs_saving() after each edit that leaves and then restores a saved value: BaseColor opacity 0.5 and back to 1, visible False and back to True, BaseColor blending Multiply and back to Normal, and a rename to 'uzp fill B', an opacity edit, the rename back to 'uzp fill A' and the opacity back to 1; in the first session and after save/reopen, with the save events and the BaseColor export.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.event.Dispatcher.connect",
        "args": {
          "events": [
            "ProjectAboutToSave",
            "ProjectSaved",
            "BusyStatusChanged"
          ]
        }
      },
      {
        "step": 3,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 3,
          "channels": [
            "BaseColor"
          ]
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 3,
          "channel": "BaseColor",
          "color": [
            0.8,
            0.2,
            0.1
          ],
          "color_space": "sRGB"
        }
      },
      {
        "step": 6,
        "call": "substance_painter.layerstack.Node.set_name",
        "args": {
          "node_step": 3,
          "name": "uzp fill A"
        }
      },
      {
        "step": 7,
        "call": "substance_painter.project.save_as",
        "args": {
          "work_file": "main.spp",
          "mode": "Full",
          "probe": true
        }
      },
      {
        "step": 8,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 9,
        "call": "substance_painter.layerstack.Node.set_opacity",
        "args": {
          "node_step": 3,
          "opacity": 0.5,
          "channel": "BaseColor",
          "probe": true
        }
      },
      {
        "step": 10,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 11,
        "call": "substance_painter.layerstack.Node.set_opacity",
        "args": {
          "node_step": 3,
          "opacity": 1.0,
          "channel": "BaseColor",
          "probe": true
        }
      },
      {
        "step": 12,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 13,
        "call": "substance_painter.layerstack.Node.set_visible",
        "args": {
          "node_step": 3,
          "visible": false,
          "probe": true
        }
      },
