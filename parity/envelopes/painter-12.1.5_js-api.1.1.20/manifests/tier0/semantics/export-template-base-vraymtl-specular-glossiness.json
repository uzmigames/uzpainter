  "tier": "0",
  "domain": "tier0/stack/base-values",
  "description": "The linear value of an empty sRGB8 base (phase1.25_pilot-wand item 2.6, decision 126): an empty project on the authored plane created with the shipped template templates/VrayMtl - Specular Glossiness.spt; BaseColor and Specular (Painter skips a map the template lacks) at OpenEXR 32f, and at PNG 16 as the control against the recorded base-values code; infinite padding, no dithering, every export step done twice in the session.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256,
          "template": "templates/VrayMtl - Specular Glossiness.spt"
        }
      },
      {
        "step": 2,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB",
            "documentMap/specular:RGB"
          ],
          "file_format": "exr",
          "bit_depth": "32f",
          "padding": "infinite",
          "dithering": false
        }
      },
      {
        "step": 3,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB",
            "documentMap/specular:RGB"
          ],
          "file_format": "exr",
          "bit_depth": "32f",
          "padding": "infinite",
          "dithering": false
        }
      },
      {
        "step": 4,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB",
            "documentMap/specular:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "infinite",
          "dithering": false
        }
      },
      {
        "step": 5,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB",
            "documentMap/specular:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "infinite",
          "dithering": false
        }
      }
    ]
  },
