{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/recorder-sample/blend-multiply-plane",
  "tier": "0",
  "domain": "tier0/blend/multiply/BaseColor",
  "description": "Acceptance sample of the Painter oracle recorder (P0-RECORDER): two uniform BaseColor fill layers on the authored plane, the upper one in Multiply mode at full opacity, BaseColor exported as 16-bit PNG. Recorded twice (same session; after save and reopen).",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top"
        }
      },
      {
        "step": 3,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 2,
          "channels": [
            "BaseColor"
          ]
        }
      },
      {
        "step": 4,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 2,
          "channel": "BaseColor",
          "color": [
            0.5,
            0.5,
            0.5
          ],
          "color_space": "Working"
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "above_step": 2
        }
      },
      {
        "step": 6,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 5,
          "channels": [
            "BaseColor"
          ]
        }
      },
      {
        "step": 7,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 5,
          "channel": "BaseColor",
          "color": [
            0.5,
            0.25,
            1.0
          ],
          "color_space": "Working"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.layerstack.Node.set_blending_mode",
        "args": {
          "node_step": 5,
          "blending_mode": "Multiply",
          "channel": "BaseColor"
        }
      },
      {
        "step": 9,
        "call": "substance_painter.layerstack.Node.set_opacity",
        "args": {
          "node_step": 5,
          "opacity": 1.0,
          "channel": "BaseColor"
        }
      },
      {
        "step": 10,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "infinite",
          "dithering": false
        }
      }
    ]
  },
  "applied_settings": [
    {
      "name": "project.normal_map_format",
      "value": "OpenGL",
      "applied_by": "recorder_api"
    },
    {
      "name": "texture_set.resolution",
      "value": 256,
      "unit": "px",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.file_format",
      "value": "png",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.bit_depth",
      "value": 16,
      "applied_by": "recorder_api"
    },
    {
      "name": "export.padding",
      "value": "infinite",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.dithering",
      "value": false,
      "applied_by": "recorder_api"
    }
  ],
  "expectations": [],
  "software": {
    "painter": {
      "product": "Adobe Substance 3D Painter",
      "version": "12.1.5",
      "build_id": "12.1.5+js-api.1.1.20"
    },
    "uzpainter_build_hash": null
  },
  "private_records": [
    {
      "record_id": "golden-record",
