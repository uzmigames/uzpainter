          "uv_wrapping_mode": "Repeat",
          "scale_mode": "Factors",
          "scale": [
            2.0,
            2.0
          ],
          "rotation": 0.0,
          "offset": [
            0.0,
            0.0
          ],
          "probe": true
        }
      },
      {
        "step": 28,
        "call": "substance_painter.layerstack.FillLayerNode.set_symmetry_enabled",
        "args": {
          "node_step": 4,
          "enabled": true,
          "probe": true
