    {
      "entry_id": "srgb8-export",
      "subject": "Export of an sRGB8 channel to a 16-bit PNG",
      "status": "calibrated",
      "formula": "export = round(65535 * R8(decode(c / 255))) for the storage code c, with decode the IEC 61966-2-1 sRGB-to-linear function (c'/12.92 for c' <= 0.04045, else ((c' + 0.055)/1.055)^2.4) and R8 rounding to 8 significant binary digits (the export values lie on an 8-significant-bit grid). The 16-bit export of an sRGB8 channel is therefore approximately linear, although the PNG is tagged sRGB.",
      "public_sources": [
        {
          "source_id": "S-SRGB",
          "locator": "IEC 61966-2-1:1999 \u00a75.2 (decoding transfer function)"
        },
