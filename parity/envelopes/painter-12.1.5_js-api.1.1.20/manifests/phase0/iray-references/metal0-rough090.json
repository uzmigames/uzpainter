    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "sphere"
        }
      },
      {
        "step": 2,
        "call": "substance_painter.display.Camera.projection_type",
        "args": {
