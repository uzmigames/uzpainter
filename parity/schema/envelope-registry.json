{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uzpainter:parity:schema:envelope-registry:1",
  "title": "UzPainter oracle envelope registry",
  "description": "parity/envelopes/registry.json (decisions 034 and 037; tools/parity/envelope/registry.py). Names the current envelope (the acceptance oracle), the candidate being recorded, every promoted envelope as history and every quarantined candidate. Public: Painter builds, envelope hashes, manifest roots and dates; the environment fields themselves stay in the private records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "current", "candidate", "envelopes", "quarantine"],
  "properties": {
    "schema": { "const": "uzpainter/parity/envelope-registry/1" },
    "current": { "$ref": "#/$defs/envelope_id" },
    "candidate": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/candidate" }]
    },
    "envelopes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/envelope" }
    },
    "quarantine": {
      "type": "array",
      "items": { "$ref": "#/$defs/quarantined" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "envelope_id": {
      "type": "string",
      "pattern": "^painter-[A-Za-z0-9][A-Za-z0-9._+-]*$",
      "maxLength": 160
    },
    "build": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$", "maxLength": 128 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "date": { "type": "string", "format": "date" },
    "record_prefix": { "type": "string", "pattern": "^([a-z0-9][a-z0-9._-]*-)?$", "maxLength": 64 },
    "repo_dir": { "type": "string", "pattern": "^parity/(manifests|envelopes/[A-Za-z0-9._+-]+/manifests)$" },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_id",
        "status",
        "painter_build",
        "painter_version",
        "manifest_root",
        "record_prefix",
        "envelope_sha256",
        "environment_known",
        "equivalent_envelopes",
        "previous",
        "promoted_on",
        "superseded_on",
        "drift_report"
      ],
      "properties": {
        "envelope_id": { "$ref": "#/$defs/envelope_id" },
        "status": { "enum": ["current", "superseded"] },
        "painter_build": { "$ref": "#/$defs/build" },
        "painter_version": { "$ref": "#/$defs/version" },
        "manifest_root": { "$ref": "#/$defs/repo_dir" },
        "record_prefix": { "$ref": "#/$defs/record_prefix" },
        "envelope_sha256": {
          "description": "SHA-256 of the envelope fields (Painter build, GPU model, driver version, OS build, colour-configuration hash) of the environment record.",
          "$ref": "#/$defs/sha256"
        },
        "environment_known": {
          "description": "False when any envelope field is `unknown` (a back-filled corpus).",
          "type": "boolean"
        },
        "equivalent_envelopes": {
          "description": "Envelope hashes of environments under the same build whose canary equalled this envelope's goldens exactly (decision 034 (d)).",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "previous": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/envelope_id" }] },
        "promoted_on": { "$ref": "#/$defs/date" },
        "superseded_on": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/date" }] },
        "drift_report": {
          "description": "The published drift report against the previous envelope (null for the first envelope).",
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^parity/reports/[a-z0-9]+/oracle-envelope-[A-Za-z0-9._+-]+\\.json$" }
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_id",
        "painter_build",
        "painter_version",
        "record_prefix",
        "envelope_sha256",
        "previous",
        "started_on"
      ],
      "properties": {
        "envelope_id": { "$ref": "#/$defs/envelope_id" },
        "painter_build": { "$ref": "#/$defs/build" },
        "painter_version": { "$ref": "#/$defs/version" },
        "record_prefix": { "$ref": "#/$defs/record_prefix" },
        "envelope_sha256": { "$ref": "#/$defs/sha256" },
        "previous": { "$ref": "#/$defs/envelope_id" },
        "started_on": { "$ref": "#/$defs/date" }
      }
    },
    "quarantined": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_id", "painter_build", "reason", "quarantined_on"],
      "properties": {
        "envelope_id": { "$ref": "#/$defs/envelope_id" },
        "painter_build": { "$ref": "#/$defs/build" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "quarantined_on": { "$ref": "#/$defs/date" }
      }
    }
  }
}
