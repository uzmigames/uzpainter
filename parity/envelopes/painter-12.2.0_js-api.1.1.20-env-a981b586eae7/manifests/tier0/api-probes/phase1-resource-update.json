{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/api-probes/phase1-resource-update",
  "tier": "0",
  "domain": "tier0/api-probes/phase1-resource-update",
  "description": "API probe (R10): resource.update_layer_stack_resource replacing the imported bitmap of one mask fill (mask_left_half -> ao_white); the returned identifiers, the node uids, the mask fill's source binding after the update and after save/reopen, with the events and the BaseColor export.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    },
    {
      "input_id": "mask_left_half",
      "kind": "image",
      "path": "parity/fixtures/api-probes/mask-left-half.png",
      "sha256": "f5d8e7f1c0bc3b577833422141afee43682f1b1fe28696e51de48e3031ccc724",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0",
        "note": "16x16 8-bit grey: left half 255, right half 0."
      }
    },
    {
      "input_id": "ao_white",
      "kind": "image",
      "path": "parity/fixtures/api-probes/ao-white.png",
      "sha256": "c73222e9295248c64101f2de610f4bc02a512b5600fb7de720840d10bdb13c91",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0",
        "note": "16x16 8-bit grey, all 255."
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.event.Dispatcher.connect",
        "args": {
          "events": [
            "LayerStacksModelDataChanged",
            "BusyStatusChanged"
          ]
        }
      },
      {
        "step": 3,
        "call": "substance_painter.resource.import_project_resource",
        "args": {
          "image": "mask_left_half",
          "usage": "TEXTURE"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.resource.import_project_resource",
        "args": {
          "image": "ao_white",
          "usage": "TEXTURE"
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top"
        }
      },
      {
        "step": 6,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 5,
          "channels": [
            "BaseColor"
          ]
        }
      },
      {
        "step": 7,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 5,
          "channel": "BaseColor",
          "color": [
            0.8,
            0.2,
            0.1
          ],
          "color_space": "sRGB"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.layerstack.Node.set_name",
        "args": {
          "node_step": 5,
          "name": "uzp masked fill"
        }
      },
      {
        "step": 9,
        "call": "substance_painter.layerstack.LayerNode.add_mask",
        "args": {
          "node_step": 5,
          "background": "Black"
        }
      },
      {
        "step": 10,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "inside_step": 5,
          "node_stack": "Mask"
        }
      },
      {
        "step": 11,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 10,
          "channel": null,
          "resource_step": 3
        }
      },
      {
        "step": 12,
        "call": "substance_painter.resource.update_layer_stack_resource",
        "args": {
          "resource_step": 3,
          "new_resource_step": 4
        }
      },
      {
        "step": 13,
        "call": "substance_painter.layerstack.FillLayerNode.get_source",
        "args": {
          "node_step": 10,
          "channel": null
        }
      },
      {
        "step": 14,
        "call": "substance_painter.layerstack.Node.uid",
        "args": {
          "node_step": 10
        }
      },
      {
        "step": 15,
        "call": "substance_painter.layerstack.Node.uid",
        "args": {
          "node_step": 5
        }
      },
      {
        "step": 16,
        "call": "substance_painter.layerstack.LayerNode.mask_effects",
        "args": {
          "node_step": 5
        }
      },
      {
        "step": 17,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "infinite",
          "dithering": false
        }
      }
    ]
  },
  "applied_settings": [
    {
      "name": "project.normal_map_format",
      "value": "OpenGL",
      "applied_by": "recorder_api"
    },
    {
      "name": "texture_set.resolution",
      "value": 256,
      "unit": "px",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.file_format",
      "value": "png",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.bit_depth",
      "value": 16,
      "applied_by": "recorder_api"
    },
    {
      "name": "export.padding",
      "value": "infinite",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.dithering",
      "value": false,
      "applied_by": "recorder_api"
    }
  ],
  "expectations": [],
  "software": {
    "painter": {
      "product": "Adobe Substance 3D Painter",
      "version": "12.2.0",
      "build_id": "12.2.0+js-api.1.1.20"
    },
    "uzpainter_build_hash": null
  },
