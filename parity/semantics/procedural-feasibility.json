    {
      "entry_id": "position-prototype",
      "subject": "Position (mesh-map generators), feasibility prototype",
      "status": "exact",
      "formula": "acc = sum over the directions with non-zero opacity of opacity * g, combined by Linear Dodge (Add) from 0, where g is the Position map channel X (Right to Left), Y (Top to Bottom) or Z (Front to Back) in 16-bit code units, replaced by 65535 - g when that direction's Invert is on; acc = 65535 - acc when the section Invert is on. Default Balance 0.5 and Contrast 0: out = round(acc). Other Balance/Contrast pairs only at calibrated points: out = clamp(1/2 + (acc - T) g) with the fitted T and g.",
      "public_sources": [
        {
          "source_id": "A-HELP-GUIDE",
          "locator": "Effects > Generators > Position (parameters)"
        },
        {
          "source_id": "A-HELP-BAKING",
          "locator": "Position mesh map"
        }
      ],
