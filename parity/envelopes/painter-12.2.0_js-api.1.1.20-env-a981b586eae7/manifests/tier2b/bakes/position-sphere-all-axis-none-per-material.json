  "golden_id": "tier2b/bakes/position-sphere-all-axis-none-per-material",
  "tier": "2b",
  "domain": "bake_map/position",
  "description": "Tier 2b bake golden of phase3.4_baker-position (decision 384) on the analytic fixture sphere: the sphere on its ground, baked low as high. Painter bakes Position at 512 px (OutputSize 9, DilationWidth 0, LowAsHigh True; Position Mode All axis, Position Normalization None, Position NormalizationScale Per Material; every other baking parameter at Painter's default; normal map format OpenGL, tangent space the project default). The baked maps are exported as PNG 16 and OpenEXR 32f, padding passthrough, no dithering; recorded twice (same session; after save and reopen). Bake backend uncontrolled.",
  "inputs": [
    {
      "input_id": "sphere-on-ground",
      "kind": "mesh",
      "path": "parity/fixtures/tier2b-bakes/sphere-on-ground.obj",
      "sha256": "19770be3cd3aa8a5ce1578be6dff4caef990f39a28019b79ff062ccd0ba42e96",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "sphere-on-ground",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 512
        }
      },
      {
        "step": 2,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "OutputSize",
          "value": [
            9,
            9
          ]
        }
      },
      {
        "step": 3,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "DilationWidth",
          "value": 0
        }
      },
      {
        "step": 4,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "LowAsHigh",
          "value": true
        }
      },
      {
        "step": 5,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "Mode",
          "usage": "Position",
          "enum_label": "All axis"
        }
      },
      {
        "step": 6,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "Normalization",
          "usage": "Position",
          "enum_label": "None"
        }
      },
      {
        "step": 7,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "NormalizationScale",
          "usage": "Position",
          "enum_label": "Per Material"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.baking.BakingParameters.set_enabled_bakers",
        "args": {
          "usages": [
            "Position"
          ]
        }
      },
      {
        "step": 9,
        "call": "substance_painter.baking.bake_async",
        "args": {}
      },
      {
        "step": 10,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "meshMap/position:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "passthrough",
          "dithering": false
        }
      },
      {
        "step": 11,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "meshMap/position:RGB"
          ],
          "file_format": "exr",
          "bit_depth": "32f",
          "padding": "passthrough",
          "dithering": false
        }
      }
    ]
  },
