        "step": 30,
        "call": "substance_painter.layerstack.LevelsEffectNode.set_parameters",
        "args": {
          "node_step": 8,
          "input_min": 0.1,
          "input_max": 0.9,
          "gamma": 1.2,
          "probe": true
