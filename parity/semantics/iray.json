  {
   "entry_id": "camera-and-pixel-filter",
   "subject": "Perspective camera of decision 046 and the pixel filter",
   "status": "calibrated",
   "formula": "Pinhole at +Z 60 looking along -Z, +Y up, 40 degrees across the square 1200 x 1200 image; sample positions drawn from the pixel filter (box; one-pixel box = uniform over the pixel square), each pixel the mean of its own samples.",
   "public_sources": [
    {
     "source_id": "P-PBRT",
     "locator": "4th ed. \u00a75.2 projective cameras, \u00a78.8 filters"
    },
    {
