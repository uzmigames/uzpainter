{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/api-probes/phase1-save-modes",
  "tier": "0",
  "domain": "tier0/api-probes/phase1-save-modes",
  "description": "API probe (R10): project.save_as_copy (Incremental), save_as (Full), then two edits and project.save with ProjectSaveMode.Incremental; the events of each save, file_path(), needs_saving() and the names of the files written in the work directory, in the first session and after save/reopen, with the BaseColor export.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.event.Dispatcher.connect",
        "args": {
          "events": [
            "ProjectAboutToSave",
            "ProjectSaved",
            "BusyStatusChanged"
          ]
        }
      },
      {
        "step": 3,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 3,
          "channels": [
            "BaseColor"
          ]
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 3,
          "channel": "BaseColor",
          "color": [
            0.8,
            0.2,
            0.1
          ],
          "color_space": "sRGB"
        }
      },
      {
        "step": 6,
        "call": "substance_painter.layerstack.Node.set_name",
        "args": {
          "node_step": 3,
          "name": "uzp fill A"
        }
      },
      {
        "step": 7,
        "call": "substance_painter.project.file_path"
      },
      {
        "step": 8,
        "call": "substance_painter.project.needs_saving"
      },
      {
        "step": 9,
        "call": "substance_painter.project.save_as_copy",
        "args": {
          "work_file": "copy.spp",
          "mode": "Incremental",
          "probe": true
        }
      },
      {
        "step": 10,
        "call": "substance_painter.project.file_path"
      },
      {
        "step": 11,
        "call": "substance_painter.project.needs_saving"
      },
      {
        "step": 12,
        "call": "substance_painter.project.save_as",
        "args": {
          "work_file": "main.spp",
          "mode": "Full",
          "probe": true
        }
      },
      {
        "step": 13,
        "call": "substance_painter.project.file_path"
      },
      {
        "step": 14,
        "call": "substance_painter.project.needs_saving"
      },
      {
        "step": 15,
        "call": "substance_painter.layerstack.Node.set_name",
        "args": {
          "node_step": 3,
          "name": "uzp save probe x",
          "probe": true
        }
      },
      {
        "step": 16,
        "call": "substance_painter.layerstack.Node.set_name",
        "args": {
          "node_step": 3,
          "name": "uzp save probe y",
          "probe": true
        }
      },
      {
        "step": 17,
        "call": "substance_painter.project.needs_saving"
      },
      {
        "step": 18,
        "call": "substance_painter.project.save",
        "args": {
          "mode": "Incremental",
          "probe": true
        }
      },
      {
        "step": 19,
        "call": "substance_painter.project.file_path"
      },
      {
        "step": 20,
        "call": "substance_painter.project.needs_saving"
      },
      {
        "step": 21,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "infinite",
          "dithering": false
        }
      }
    ]
  },
  "applied_settings": [
    {
      "name": "project.normal_map_format",
      "value": "OpenGL",
      "applied_by": "recorder_api"
    },
    {
      "name": "texture_set.resolution",
      "value": 256,
      "unit": "px",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.file_format",
      "value": "png",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.bit_depth",
      "value": 16,
      "applied_by": "recorder_api"
    },
    {
      "name": "export.padding",
      "value": "infinite",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.dithering",
      "value": false,
      "applied_by": "recorder_api"
    }
  ],
  "expectations": [],
  "software": {
    "painter": {
      "product": "Adobe Substance 3D Painter",
      "version": "12.1.5",
      "build_id": "12.1.5+js-api.1.1.20"
    },
    "uzpainter_build_hash": null
  },
  "private_records": []
}
