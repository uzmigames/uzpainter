{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uzmigames:uzpainter:export-receipt:1",
  "title": "UzPainter export receipt (uzpainter/export-receipt/1)",
  "description": "The receipt of one published export generation (docs/architecture/08-export.md section 5, src/export/receipt.h, decision 097). $defs export, map_format, comparison, source, moment, path, sha256 and file are copied unchanged from Assets3D Pipeline/manifest/manifest-schema-v2.json at commit b14511b78ae627ceb5be5e69f0740a3804570311 (UzmiGames' own pipeline schema).",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "evaluator_profile",
    "compat_profile",
    "app_version",
    "build",
    "resource_hashes",
    "generation",
    "moment",
    "plan",
    "plan_hash",
    "files",
    "skipped",
    "manifest_files",
    "manifest_export"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "uzpainter/export-receipt/1"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "evaluator_profile": {
      "type": "string",
      "minLength": 1
    },
    "compat_profile": {
      "type": "string",
      "minLength": 1
    },
    "app_version": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "type": "string",
      "minLength": 1
    },
    "resource_hashes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hash"
      },
      "uniqueItems": true
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9]{6,18}$"
    },
    "moment": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "plan": {
      "const": "plan.json"
    },
    "plan_hash": {
      "$ref": "#/$defs/hash"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/receipt_file"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skipped_map"
      }
    },
    "manifest_files": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/file"
      },
      "required": [
        "export-plan",
        "project"
      ]
    },
    "manifest_export": {
      "anyOf": [
        {
          "$ref": "#/$defs/export"
        },
        {
          "type": "null"
        }
      ]
    },
    "non_conformant": {
      "description": "Only in a generation of the diagnostic measure export (src/export/write.h, decision 286): not Painter's output. The production refusals it bypassed, per file.",
      "type": "object",
      "required": [
        "mode",
        "decision",
        "bypassed"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "diagnostic-measure"
        },
        "decision": {
          "const": "286"
        },
        "bypassed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "refusal"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "refusal": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "undecided": {
          "description": "Per file, the texels written by a rule whose form is not recorded (decision 308): the uncovered texels of a combined virtual normal with a bound Normal mesh map.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "texels",
              "rule"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "texels": {
                "type": "integer",
                "minimum": 1
              },
              "rule": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delivery_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)\\.\\.?(/|$))[^/]+(?:/[^/]+)*$",
      "not": {
        "pattern": "\\.uzp-staging(/|$)"
      }
    },
    "receipt_file": {
      "type": "object",
      "required": [
        "path",
        "key",
        "root_path",
        "preset",
        "bytes",
        "sha256",
        "format",
        "bit_depth",
        "colour_space",
        "size",
        "layout",
        "channels",
        "normal",
        "consumer_gaps"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/delivery_path"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "root_path": {
          "type": "string",
          "minLength": 1
        },
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "format": {
          "enum": [
            "png",
            "exr",
            "tga",
            "bmp",
            "jpeg",
            "dds",
            "json",
            "uztexture"
          ]
        },
        "bit_depth": {
          "enum": [
            "8",
            "16",
            "16f",
            "32f",
            null
          ]
        },
        "colour_space": {
          "enum": [
            "linear",
            "sRGB",
            null
          ]
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "layout": {
          "enum": [
            "L",
            "LA",
            "RGB",
            "RGBA",
            "Statistics"
          ]
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/channel_mapping"
          }
        },
        "normal": {
          "anyOf": [
            {
              "$ref": "#/$defs/normal_tag"
            },
            {
              "type": "null"
            }
          ]
        },
        "consumer_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consumer_gap"
          }
        },
        "uztexture": {
          "$ref": "#/$defs/uztexture_derivative"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "json"
              }
            }
          },
          "then": {
            "properties": {
              "bit_depth": {
                "const": null
              },
              "colour_space": {
                "const": null
              },
              "layout": {
                "const": "Statistics"
              }
            }
          },
          "else": {
            "properties": {
              "bit_depth": {
                "type": "string"
              },
              "colour_space": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "uztexture"
              }
            }
          },
          "then": {
            "required": [
              "uztexture"
            ],
            "properties": {
              "bit_depth": {
                "const": "8"
              },
              "colour_space": {
                "const": "linear"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "uztexture"
              ]
            }
          }
        }
      ]
    },
    "uztexture_derivative": {
      "description": "A .uztexture normal derivative (src/export/write.h EncodedUzTexture, decision 316): cooked from its canonical PNG 16 file `source`; stored as BC5, or as RGBA8 when the negative-Z policy rgb routed a map holding negative-Z texels (B <= 32767). Policy fail with such texels publishes nothing, so a published derivative under fail has none.",
      "type": "object",
      "required": [
        "source",
        "binding",
        "format",
        "srgb",
        "mips",
        "encoder",
        "negative_z"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/delivery_path"
        },
        "binding": {
          "const": "normal"
        },
        "format": {
          "enum": [
            "BC5",
            "RGBA8"
          ]
        },
        "srgb": {
          "const": false
        },
        "mips": {
          "type": "integer",
          "minimum": 1
        },
        "encoder": {
          "type": "string",
          "minLength": 1
        },
        "negative_z": {
          "type": "object",
          "required": [
            "policy",
            "texels",
            "first",
            "routed"
          ],
          "additionalProperties": false,
          "properties": {
            "policy": {
              "enum": [
                "fail",
                "rgb"
              ]
            },
            "texels": {
              "type": "integer",
              "minimum": 0
            },
            "first": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "null"
                }
              ]
            },
            "routed": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "routed": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "policy": {
                    "const": "rgb"
                  },
                  "texels": {
                    "minimum": 1
                  },
                  "first": {
                    "type": "array"
                  }
                }
              },
              "else": {
                "properties": {
                  "texels": {
                    "const": 0
                  },
                  "first": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "negative_z": {
                "properties": {
                  "routed": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "format": {
                "const": "RGBA8"
              }
            }
          },
          "else": {
            "properties": {
              "format": {
                "const": "BC5"
              }
            }
          }
        }
      ]
    },
    "channel_mapping": {
      "type": "object",
      "required": [
        "dest_channel",
        "src_channel",
        "src_map_type",
        "src_map_name"
      ],
      "additionalProperties": false,
      "properties": {
        "dest_channel": {
          "enum": [
            "L",
            "R",
            "G",
            "B",
            "A"
          ]
        },
        "src_channel": {
          "enum": [
            "L",
            "R",
            "G",
            "B",
            "A"
          ]
        },
        "src_map_type": {
          "enum": [
            "documentMap",
            "meshMap",
            "virtualMap",
            "defaultMap",
            "diagnosticMap"
          ]
        },
        "src_map_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normal_tag": {
      "type": "object",
      "required": [
        "role",
        "relief"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "combined",
            "geometry_only"
          ]
        },
        "relief": {
          "anyOf": [
            {
              "$ref": "#/$defs/relief_round"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "combined"
              }
            }
          },
          "then": {
            "properties": {
              "relief": {
                "$ref": "#/$defs/relief_round"
              }
            }
          },
          "else": {
            "properties": {
              "relief": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "relief_round": {
      "type": "object",
      "required": [
        "revision",
        "height_hash",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "height_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "const": ""
            }
          ]
        },
        "method": {
          "enum": [
            "Sharp",
            "SmoothSobel"
          ]
        }
      }
    },
    "consumer_gap": {
      "type": "object",
      "required": [
        "channel",
        "gap"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "gap": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "skipped_map": {
      "type": "object",
      "required": [
        "root_path",
        "preset",
        "file_name",
        "kind",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "root_path": {
          "type": "string",
          "minLength": 1
        },
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "absent",
            "not_written",
            "export_error"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "export": {
      "type": "object",
      "description": "sources/outputs are keys of files; identity.export_round identifies the round when it exists. An exported file is not an approval.",
      "required": [
        "sources",
        "outputs",
        "moment",
        "preset",
        "maps",
        "comparison",
        "evidence",
        "open_items"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "moment": {
          "$ref": "#/$defs/moment"
        },
        "preset": {
          "anyOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        },
        "maps": {
          "type": "object",
          "description": "Keys of files for the maps of this output.",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/map_format"
          }
        },
        "comparison": {
          "$ref": "#/$defs/comparison"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "open_items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "map_format": {
      "type": "object",
      "description": "Output parameters of this round, per map; null if not proven. Do not copy parameters from an earlier export.",
      "required": [
        "resolution",
        "bit_depth",
        "color_space"
      ],
      "properties": {
        "resolution": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "bit_depth": {
          "enum": [
            8,
            16,
            32,
            null
          ]
        },
        "color_space": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "description": "Distinguishes bytes, decoded pixels and qualified visual equivalence. report points to real measurements/inspection; pending does not claim reproduction.",
      "required": [
        "result",
        "report",
        "tolerance",
        "differences"
      ],
      "properties": {
        "result": {
          "enum": [
            "identical-bytes",
            "identical-pixels",
            "visual-equivalence",
            "different",
            "pending"
          ]
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        },
        "tolerance": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "differences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "identical-bytes",
                  "identical-pixels",
                  "visual-equivalence",
                  "different"
                ]
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "report": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "identical-pixels",
                  "visual-equivalence"
                ]
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "tolerance": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "description": "file is a key of files; selector is a JSON Pointer for JSON or an explicit identifier of a packed resource. Never runs the recipe.",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "moment": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ],
      "description": "Instant with time zone; a date when the source records only the day; null when unknown."
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)\\.\\.?(/|$))[^/]+(?:/[^/]+)*$",
      "description": "Path relative to the Assets3D root, with /; no drive, leading slash, . or ... Do not move binaries to fit the structure."
    },
    "sha256": {
      "type": "object",
      "description": "Full hash of the bytes. A copied legacy digest stays not-verified; null means a missing digest.",
      "required": [
        "algorithm",
        "value",
        "verification"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "verification": {
          "enum": [
            "verified",
            "not-verified"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "const": "verified"
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "file": {
      "type": "object",
      "description": "bytes is the size of the whole file; null only if unknown. source attributes legacy values; revision complements the script/recipe hash, without replacing it.",
      "required": [
        "path",
        "role",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "role": {
          "enum": [
            "checkpoint",
            "painter-project",
            "map",
            "export",
            "reference",
            "support",
            "source",
            "recipe",
            "script",
            "configuration",
            "evidence",
            "report"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "sha256": {
                "properties": {
                  "verification": {
                    "const": "verified"
                  }
                },
                "required": [
                  "verification"
                ]
              }
            },
            "required": [
              "sha256"
            ]
          },
          "then": {
            "properties": {
              "bytes": {
                "type": "integer"
              }
            }
          }
        }
      ]
    }
  }
}
