{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/api-probes/ocio-srgb8-threshold-ties",
  "tier": "0",
  "domain": "tier0/api-probes/ocio16-input",
  "description": "sRGB8 threshold-tie probe (decision 406): an authored OpenEXR float bitmap whose column x holds the native store's threshold t_x and its binary16 and float32 neighbours, set to GenericColorSpace.Raw (a data space: no OCIO conversion), into BaseColor sRGB8 on the authored 256px full-UV plane. Nearest identity UV, Normal opacity 1. Setup runs once. Read the typed bitmap space before one PNG 8-bit capture export with no dithering or padding; Full save/reopen repeats that getter and export without any setter. Records which code Painter stores for a value on a threshold; no fit, preset parity or capability promotion.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    },
    {
      "input_id": "srgb8-thresholds",
      "kind": "image",
      "path": "parity/fixtures/tier0-semantics/bitmaps/srgb8-thresholds.exr",
      "sha256": "de73d8218d8d21fd04c35955319ce8643fe597c443c542b30d549be351e19e73",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0",
        "note": "Generated by tools/parity/tier0_semantics/srgb8_threshold_ties.py."
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.textureset.Stack.edit_channel",
        "args": {
          "channel": "BaseColor",
          "format": "sRGB8"
        }
      },
      {
        "step": 3,
        "call": "substance_painter.resource.import_project_resource",
        "args": {
          "input": "srgb8-thresholds",
          "usage": "TEXTURE"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top",
          "texture_set": "uzp_plane"
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 4,
          "channels": [
            "BaseColor"
          ]
        }
      },
      {
        "step": 6,
        "call": "substance_painter.layerstack.Node.set_blending_mode",
        "args": {
          "node_step": 4,
          "blending_mode": "Normal",
          "channel": "BaseColor"
        }
      },
      {
        "step": 7,
        "call": "substance_painter.layerstack.Node.set_opacity",
        "args": {
          "node_step": 4,
          "opacity": 1.0,
          "channel": "BaseColor"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.layerstack.FillLayerNode.set_projection_mode",
        "args": {
          "node_step": 4,
          "projection_mode": "UV"
        }
      },
      {
        "step": 9,
        "call": "substance_painter.layerstack.FillLayerNode.set_projection_parameters",
        "args": {
          "node_step": 4,
          "filtering_mode": "Nearest",
          "uv_wrapping_mode": "Repeat",
          "scale_mode": "Factors",
          "scale": [
            1.0,
            1.0
          ],
          "rotation": 0.0,
          "offset": [
            0.0,
            0.0
          ]
        }
      },
      {
        "step": 10,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 4,
          "channel": "BaseColor",
          "resource_step": 3
        }
      },
      {
        "step": 11,
        "call": "substance_painter.source.SourceBitmap.set_color_space",
        "args": {
          "node_step": 4,
          "channel": "BaseColor",
          "color_space": "GenericColorSpace.Raw"
        }
      },
      {
        "step": 12,
        "call": "substance_painter.source.SourceBitmap.get_color_space",
        "args": {
          "node_step": 4,
          "channel": "BaseColor",
          "typed": true
        }
      },
      {
        "step": 13,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB"
          ],
          "file_format": "png",
          "bit_depth": 8,
          "padding": "passthrough",
          "dithering": false,
          "key_by_step": true
        }
      }
    ]
  },
  "applied_settings": [
    {
      "name": "project.normal_map_format",
