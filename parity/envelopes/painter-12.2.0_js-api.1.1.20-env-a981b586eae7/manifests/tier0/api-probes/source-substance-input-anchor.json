        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 128
        }
      },
      {
        "step": 2,
        "call": "substance_painter.layerstack.insert_paint",
        "args": {
          "position": "top"
        }
      },
      {
        "step": 3,
        "call": "substance_painter.layerstack.insert_anchor_point_effect",
        "args": {
          "inside_step": 2,
          "node_stack": "Content",
          "name": "uzp-anchor"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top"
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.FillLayerNode.set_material_source",
        "args": {
          "node_step": 4,
          "resource_url": "resource://starter_assets/inflate_shrinkwrap/inflate_shrinkwrap?version=a0b1718de23d379fb35250414e364bb8f8fbf50c.sbsar"
        }
      },
      {
        "step": 6,
        "call": "substance_painter.source.SourceSubstance.image_inputs",
        "args": {
          "node_step": 4,
          "material": true
        }
      },
      {
        "step": 7,
        "call": "substance_painter.source.SourceSubstance.get_source",
        "args": {
          "node_step": 4,
          "material": true,
          "input_index": 0
        }
      },
      {
        "step": 8,
        "call": "substance_painter.source.SourceSubstance.set_source",
        "args": {
          "node_step": 4,
          "material": true,
          "input_index": 0,
          "anchor_step": 3,
          "probe": true
        }
      },
      {
        "step": 9,
        "call": "substance_painter.source.SourceSubstance.get_parameters",
        "args": {
          "node_step": 4,
          "material": true
        }
      },
      {
        "step": 10,
        "call": "substance_painter.source.SourceSubstance.get_source",
        "args": {
          "node_step": 4,
          "material": true,
          "input_index": 0
        }
      },
      {
        "step": 11,
        "call": "substance_painter.source.SourceSubstance.reset_source",
        "args": {
          "node_step": 4,
          "material": true,
          "input_index": 0,
          "probe": true
        }
      },
      {
        "step": 12,
        "call": "substance_painter.source.SourceSubstance.get_parameters",
        "args": {
          "node_step": 4,
          "material": true
        }
      },
      {
        "step": 13,
        "call": "substance_painter.source.SourceSubstance.get_source",
        "args": {
          "node_step": 4,
          "material": true,
          "input_index": 0
        }
      }
    ]
