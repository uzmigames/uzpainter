      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "grid2x2",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.event.Dispatcher.connect",
        "args": {
          "events": [
            "BusyStatusChanged",
            "ProjectEditionEntered",
            "ProjectEditionLeft",
            "LayerStacksModelDataChanged"
          ]
        }
      },
      {
        "step": 3,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 3,
          "channels": [
            "BaseColor"
          ]
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 3,
          "channel": "BaseColor",
          "color": [
            0.8,
            0.2,
            0.1
          ],
          "color_space": "sRGB"
        }
      },
      {
        "step": 6,
        "call": "substance_painter.layerstack.Node.set_name",
        "args": {
          "node_step": 3,
          "name": "uzp fill A"
        }
      },
      {
        "step": 7,
        "call": "substance_painter.textureset.all_texture_sets"
      },
      {
        "step": 8,
        "call": "substance_painter.project.reload_mesh",
        "args": {
          "mesh": "grid4x2",
          "import_cameras": false,
          "preserve_strokes": true,
          "probe": true
        }
      },
      {
        "step": 9,
        "call": "substance_painter.textureset.all_texture_sets"
      },
      {
        "step": 10,
        "call": "substance_painter.layerstack.get_root_layer_nodes"
      },
      {
        "step": 11,
        "call": "substance_painter.layerstack.Node.uid",
        "args": {
          "node_step": 3
        }
      },
      {
        "step": 12,
        "call": "substance_painter.project.reload_mesh",
        "args": {
          "work_file": "absent.obj",
          "import_cameras": false,
          "preserve_strokes": true,
          "probe": true
        }
      },
      {
        "step": 13,
        "call": "substance_painter.textureset.all_texture_sets"
      },
      {
        "step": 14,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "infinite",
          "dithering": false
        }
      }
    ]
  },
