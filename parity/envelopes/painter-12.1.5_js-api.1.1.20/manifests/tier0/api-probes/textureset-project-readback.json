{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/api-probes/textureset-project-readback",
  "tier": "0",
  "domain": "tier0/api-probes/textureset-project-readback",
  "description": "API probe: set->get readback of the texture-set resolution and mesh-map resources (Normal and AO from authored images) and of the project state readbacks (needs_saving, file name, name), after setting a resource already used by another mesh-map usage.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    },
    {
      "input_id": "normal_flat",
      "kind": "image",
      "path": "parity/fixtures/api-probes/normal-flat.png",
      "sha256": "aa552c67f483c6ab010b10e50c81f3a6bdf3858c2d066901f6f0151e12ed2594",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0",
        "note": "16x16 8-bit RGB flat tangent-space normal (128,128,255)."
      }
    },
    {
      "input_id": "ao_white",
      "kind": "image",
      "path": "parity/fixtures/api-probes/ao-white.png",
      "sha256": "c73222e9295248c64101f2de610f4bc02a512b5600fb7de720840d10bdb13c91",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0",
        "note": "16x16 8-bit grey, all 255."
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.textureset.set_resolutions",
        "args": {
          "width": 512,
          "height": 512
        }
      },
      {
        "step": 3,
        "call": "substance_painter.resource.import_project_resource",
        "args": {
          "image": "normal_flat",
          "usage": "TEXTURE"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.resource.import_project_resource",
        "args": {
          "image": "ao_white",
          "usage": "TEXTURE"
        }
      },
      {
        "step": 5,
        "call": "substance_painter.textureset.TextureSet.set_mesh_map_resource",
        "args": {
          "usage": "Normal",
          "resource_step": 3
        }
      },
      {
        "step": 6,
        "call": "substance_painter.textureset.TextureSet.set_mesh_map_resource",
        "args": {
          "usage": "AO",
          "resource_step": 4
        }
      },
      {
        "step": 7,
        "call": "substance_painter.textureset.TextureSet.set_mesh_map_resource",
        "args": {
          "usage": "Curvature",
          "resource_step": 3,
          "probe": true
        }
      },
      {
        "step": 8,
        "call": "substance_painter.textureset.TextureSet.get_resolution",
        "args": {}
      },
      {
        "step": 9,
        "call": "substance_painter.textureset.TextureSet.get_mesh_map_resource",
        "args": {
          "usage": "Normal"
        }
      },
      {
        "step": 10,
        "call": "substance_painter.textureset.TextureSet.get_mesh_map_resource",
        "args": {
          "usage": "AO"
        }
      },
      {
        "step": 11,
        "call": "substance_painter.textureset.TextureSet.get_mesh_map_resource",
        "args": {
          "usage": "Curvature"
        }
      },
      {
        "step": 12,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 13,
        "call": "substance_painter.project.file_path",
        "args": {}
      },
      {
        "step": 14,
        "call": "substance_painter.project.name",
        "args": {}
      }
    ]
  },
  "applied_settings": [
    {
      "name": "project.normal_map_format",
      "value": "OpenGL",
      "applied_by": "recorder_api"
    },
    {
      "name": "texture_set.resolution",
      "value": 256,
      "unit": "px",
      "applied_by": "recorder_api"
    }
  ],
  "expectations": [],
  "software": {
    "painter": {
      "product": "Adobe Substance 3D Painter",
      "version": "12.1.5",
      "build_id": "12.1.5+js-api.1.1.20"
    },
    "uzpainter_build_hash": null
  },
  "private_records": [
