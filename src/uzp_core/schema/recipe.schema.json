{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uzmigames.dev/uzpainter/schema/recipe/1",
  "title": "UzPainter recipe dump",
  "description": "The recipe dump of one project revision (docs/architecture/03-project-model.md sections 5 and 7; src/uzp_core/manifest/recipe.h; key reference src/uzp_core/MANIFEST.md section 8; decision 122): the ARC-11 header, the recipe body (every output-determining field), its digest (the SHA-256 of the body's canonical JSON) and the rebuild block (the state only a rebuild needs, outside the digest). The body keeps the manifest's keys and shapes (src/uzp_core/schema/manifest.schema.json) without ids, inert state, provenance paths or keys this version does not read; references are JSON pointers inside the texture set, paint planes their content, and every stack channel carries its base value. Rules the schema cannot express (pointers that name a node, channels drawn from the stack, the digest) are checked by the rebuild (ProjectFromRecipe).",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "evaluator_profile",
    "compat_profile",
    "app_version",
    "resource_hashes",
    "recipe",
    "rebuild",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "uzpainter/recipe/1"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "evaluator_profile": {
      "$ref": "#/$defs/nonEmpty"
    },
    "compat_profile": {
      "$ref": "#/$defs/nonEmpty"
    },
    "app_version": {
      "$ref": "#/$defs/nonEmpty"
    },
    "resource_hashes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "recipe": {
      "$ref": "#/$defs/recipe"
    },
    "rebuild": {
      "description": "Outside the digest: the state only a rebuild needs, as {JSON pointer into the id-less document: value} (src/uzp_core/manifest/recipe.h lists the keys; ProjectFromRecipe refuses any other).",
      "type": "object",
      "propertyNames": {
        "pattern": "^(/[^/]*)+$"
      }
    },
    "digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "optionalSha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "optionalString": {
      "type": [
        "string",
        "null"
      ]
    },
    "assetUrl": {
      "type": "string",
      "pattern": "^uzasset://[a-z0-9_.-]+/[a-z0-9_.-]+@[A-Za-z0-9_.+-]+$"
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "normalMapFormat": {
      "enum": [
        "OpenGL",
        "DirectX"
      ]
    },
    "channelType": {
      "enum": [
        "AO",
        "AbsorptionColor",
        "Anisotropyangle",
        "Anisotropylevel",
        "BaseColor",
        "BaseDiffuseRoughness",
        "BaseMetalness",
        "BaseWeight",
        "BlendingMask",
        "CoatColor",
        "CoatNormal",
        "CoatOpacity",
        "CoatRoughness",
        "CoatRoughnessAnisotropy",
        "CoatSpecularLevel",
        "CoatTangent",
        "CoatWeight",
        "Diffuse",
        "Displacement",
        "EmissionColor",
        "Emissive",
        "FuzzColor",
        "FuzzRoughness",
        "FuzzWeight",
        "Glossiness",
        "Height",
        "Ior",
        "Metallic",
        "Normal",
        "Opacity",
        "Reflection",
        "Roughness",
        "Scattering",
        "ScatteringColor",
        "SheenColor",
        "SheenOpacity",
        "SheenRoughness",
        "Specular",
        "SpecularColor",
        "SpecularEdgeColor",
        "SpecularRoughness",
        "SpecularRoughnessAnisotropy",
        "SpecularWeight",
        "Specularlevel",
        "SubsurfaceColor",
        "SubsurfaceRadiusScale",
        "SubsurfaceWeight",
        "Tangent",
        "ThinFilmWeight",
        "Translucency",
        "TransmissionColor",
        "TransmissionWeight",
        "Transmissive",
        "User0",
        "User1",
        "User10",
        "User11",
        "User12",
        "User13",
        "User14",
        "User15",
        "User16",
        "User17",
        "User18",
        "User19",
        "User2",
        "User20",
        "User21",
        "User22",
        "User23",
        "User24",
        "User25",
        "User26",
        "User27",
        "User28",
        "User29",
        "User3",
        "User30",
        "User31",
        "User4",
        "User5",
        "User6",
        "User7",
        "User8",
        "User9"
      ]
    },
    "channelFormat": {
      "enum": [
        "sRGB8",
        "L8",
        "RGB8",
        "L16",
        "RGB16",
        "L16F",
        "RGB16F",
        "L32F",
        "RGB32F"
      ]
    },
    "meshMapUsage": {
      "enum": [
        "AO",
        "BentNormals",
        "Curvature",
        "Height",
        "ID",
        "Normal",
        "Opacity",
        "Position",
        "Thickness",
        "WorldSpaceNormal"
      ]
    },
    "blendingMode": {
      "enum": [
        "Normal",
        "PassThrough",
        "Disable",
        "Replace",
        "Multiply",
        "Divide",
        "InverseDivide",
        "Darken",
        "Lighten",
        "LinearDodge",
        "Subtract",
        "InverseSubtract",
        "Difference",
        "Exclusion",
        "SignedAddition",
        "Overlay",
        "Screen",
        "LinearBurn",
        "ColorBurn",
        "ColorDodge",
        "SoftLight",
        "HardLight",
        "VividLight",
        "LinearLight",
        "PinLight",
        "Tint",
        "Saturation",
        "Color",
        "Value",
        "NormalMapCombine",
        "NormalMapDetail",
        "NormalMapInverseDetail"
      ]
    },
    "powerOfTwo": {
      "enum": [
        128,
        256,
        512,
        1024,
        2048,
        4096,
        8192
      ]
    },
    "resolution": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "$ref": "#/$defs/powerOfTwo"
        },
        "height": {
          "$ref": "#/$defs/powerOfTwo"
        }
      },
      "unevaluatedProperties": false
    },
    "blending": {
      "type": "object",
      "required": [
        "mode",
        "opacity"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/blendingMode"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        }
      },
      "unevaluatedProperties": false
    },
    "channelBlending": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/channelType"
      },
      "additionalProperties": {
        "$ref": "#/$defs/blending"
      }
    },
    "channelList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/channelType"
      }
    },
    "resourceBinding": {
      "type": "object",
      "required": [
        "sha256",
        "alias"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "alias": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nonEmpty"
            }
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "levels": {
      "type": "object",
      "required": [
        "affected_channel",
        "components"
      ],
      "properties": {
        "affected_channel": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/channelType"
            }
          ]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "input_min",
              "input_max",
              "gamma",
              "output_min",
              "output_max",
              "clamp"
            ],
            "properties": {
              "input_min": {
                "type": "number"
              },
              "input_max": {
                "type": "number"
              },
              "gamma": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "output_min": {
                "type": "number"
              },
              "output_max": {
                "type": "number"
              },
              "clamp": {
                "type": "boolean"
              }
            },
            "unevaluatedProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    },
    "proceduralRef": {
      "type": "object",
      "required": [
        "asset",
        "params",
        "preset",
        "image_inputs",
        "output_mapping",
        "mask_output",
        "resolution_override"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/assetUrl"
        },
        "params": {
          "type": "object"
        },
        "preset": {
          "$ref": "#/$defs/optionalString"
        },
        "image_inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/resourceBinding"
          }
        },
        "output_mapping": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/channelType"
          },
          "additionalProperties": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "mask_output": {
          "$ref": "#/$defs/optionalString"
        },
        "resolution_override": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/resolution"
            }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "uniform_color",
            "bitmap",
            "vector",
            "font",
            "procedural",
            "reference"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "uniform_color"
              }
            }
          },
          "then": {
            "required": [
              "rgb",
              "color_space"
            ],
            "properties": {
              "rgb": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "color_space": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bitmap"
              }
            }
          },
          "then": {
            "required": [
              "resource",
              "color_space"
            ],
            "properties": {
              "resource": {
                "$ref": "#/$defs/resourceBinding"
              },
              "color_space": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "vector",
                  "font"
                ]
              }
            }
          },
          "then": {
            "required": [
              "resource",
              "params"
            ],
            "properties": {
              "resource": {
                "$ref": "#/$defs/resourceBinding"
              },
              "params": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "procedural"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/proceduralRef"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reference"
              }
            }
          },
          "then": {
            "required": [
              "anchor",
              "channel_mapping",
              "referenced_channel",
              "alpha_matte",
              "levels"
            ],
            "properties": {
              "anchor": {
                "$ref": "#/$defs/nodePointer"
              },
              "channel_mapping": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/channelType"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/channelType"
                }
              },
              "referenced_channel": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/channelType"
                  }
                ]
              },
              "alpha_matte": {
                "type": "boolean"
              },
              "levels": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/levels"
                  }
                ]
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "optionalSource": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/source"
        }
      ]
    },
    "projection": {
      "type": "object",
      "required": [
        "mode",
        "uv",
        "params"
      ],
      "properties": {
        "mode": {
          "enum": [
            "Fill",
            "UV",
            "Triplanar",
            "Planar",
            "Spherical",
            "Cylindrical",
            "Warp",
            "UVSetToUVSet"
          ]
        },
        "uv": {
          "type": "object",
          "required": [
            "filtering_mode",
            "uv_wrapping_mode",
            "uv_transformation"
          ],
          "properties": {
            "filtering_mode": {
              "enum": [
                "BilinearHQ",
                "BilinearSharp",
                "Nearest"
              ]
            },
            "uv_wrapping_mode": {
              "enum": [
                "RepeatNone",
                "RepeatHorizontally",
                "RepeatVertically",
                "Repeat"
              ]
            },
            "uv_transformation": {
              "type": "object",
              "required": [
                "scale_mode",
                "scale",
                "rotation",
                "offset"
              ],
              "properties": {
                "scale_mode": {
                  "enum": [
                    "Factors",
                    "MaterialPhysicalSize",
                    "CustomPhysicalSize"
                  ]
                },
                "scale": {
                  "$ref": "#/$defs/numberPair"
                },
                "rotation": {
                  "type": "number"
                },
                "offset": {
                  "$ref": "#/$defs/numberPair"
                }
              },
              "unevaluatedProperties": false
            }
          },
          "unevaluatedProperties": false
        },
        "params": {
          "type": "object"
        }
      },
      "unevaluatedProperties": false
    },
    "numberPair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "symmetry": {
      "type": "object",
      "required": [
        "enabled",
        "params"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "params": {
          "type": "object"
        }
      },
      "unevaluatedProperties": false
    },
    "contentFill": {
      "type": "object",
      "required": [
        "source_mode",
        "sources",
        "material_source",
        "active_channels",
        "projection",
        "symmetry"
      ],
      "properties": {
        "source_mode": {
          "enum": [
            "Split",
            "Material"
          ]
        },
        "sources": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/channelType"
          },
          "additionalProperties": {
            "$ref": "#/$defs/source"
          }
        },
        "material_source": {
          "$ref": "#/$defs/optionalSource"
        },
        "active_channels": {
          "$ref": "#/$defs/channelList"
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "symmetry": {
          "$ref": "#/$defs/symmetry"
        }
      },
      "unevaluatedProperties": false
    },
    "maskFill": {
      "type": "object",
      "required": [
        "source",
        "projection",
        "symmetry"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/optionalSource"
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "symmetry": {
          "$ref": "#/$defs/symmetry"
        }
      },
      "unevaluatedProperties": false
    },
    "contentPaint": {
      "type": "object",
      "required": [
        "planes"
      ],
      "properties": {
        "planes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/channelType"
          },
          "additionalProperties": {
            "$ref": "#/$defs/planeContent"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "maskPaint": {
      "type": "object",
      "required": [
        "plane"
      ],
      "properties": {
        "plane": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/planeContent"
            }
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "effectCommon": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "visible",
        "blending"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "generator",
                  "filter"
                ]
              }
            }
          },
          "then": {
            "required": [
              "procedural"
            ],
            "properties": {
              "procedural": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/proceduralRef"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "levels"
              }
            }
          },
          "then": {
            "required": [
              "levels"
            ],
            "properties": {
              "levels": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/levels"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "compare_mask"
              }
            }
          },
          "then": {
            "required": [
              "compare_mask"
            ],
            "properties": {
              "compare_mask": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "color_selection"
              }
            }
          },
          "then": {
            "required": [
              "color_selection"
            ],
            "properties": {
              "color_selection": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "anchor"
              }
            }
          },
          "then": {
            "required": [
              "anchor_name"
            ],
            "properties": {
              "anchor_name": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "contentEffect": {
      "description": "An effect of a layer's content stack: per-channel blending; compare mask and colour selection effects are allowed only in mask stacks.",
      "$ref": "#/$defs/effectCommon",
      "required": [
        "active_channels"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fill",
            "paint",
            "generator",
            "filter",
            "levels",
            "anchor"
          ]
        },
        "blending": {
          "$ref": "#/$defs/channelBlending"
        },
        "active_channels": {
          "$ref": "#/$defs/channelList"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fill"
              }
            }
          },
          "then": {
            "required": [
              "fill"
            ],
            "properties": {
              "fill": {
                "$ref": "#/$defs/contentFill"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "paint"
              }
            }
          },
          "then": {
            "required": [
              "paint"
            ],
            "properties": {
              "paint": {
                "$ref": "#/$defs/contentPaint"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "maskEffect": {
      "description": "An effect of a layer's mask stack: mono-channel blending, sources and planes.",
      "$ref": "#/$defs/effectCommon",
      "properties": {
        "kind": {
          "enum": [
            "fill",
            "paint",
            "generator",
            "filter",
            "levels",
            "compare_mask",
            "color_selection",
            "anchor"
          ]
        },
        "blending": {
          "$ref": "#/$defs/blending"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fill"
              }
            }
          },
          "then": {
            "required": [
              "fill"
            ],
            "properties": {
              "fill": {
                "$ref": "#/$defs/maskFill"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "paint"
              }
            }
          },
          "then": {
            "required": [
              "paint"
            ],
            "properties": {
              "paint": {
                "$ref": "#/$defs/maskPaint"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "layer": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "visible",
        "blending",
        "content_effects",
        "mask",
        "geometry_mask"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fill",
            "paint",
            "group",
            "instance"
          ]
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "blending": {
          "$ref": "#/$defs/channelBlending"
        },
        "content_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentEffect"
          }
        },
        "mask": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "background",
                "enabled",
                "blending",
                "effects"
              ],
              "properties": {
                "background": {
                  "enum": [
                    "Black",
                    "White"
                  ]
                },
                "enabled": {
                  "type": "boolean"
                },
                "blending": {
                  "$ref": "#/$defs/blending"
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/maskEffect"
                  }
                }
              },
              "unevaluatedProperties": false
            }
          ]
        },
        "geometry_mask": {
          "type": "object",
          "required": [
            "type",
            "inclusion_list",
            "items"
          ],
          "properties": {
            "type": {
              "enum": [
                "Mesh",
                "UVTile"
              ]
            },
            "inclusion_list": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nonEmpty"
              }
            }
          },
          "unevaluatedProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fill"
              }
            }
          },
          "then": {
            "required": [
              "fill"
            ],
            "properties": {
              "fill": {
                "$ref": "#/$defs/contentFill"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "paint"
              }
            }
          },
          "then": {
            "required": [
              "paint"
            ],
            "properties": {
              "paint": {
                "$ref": "#/$defs/contentPaint"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "group"
              }
            }
          },
          "then": {
            "required": [
              "children"
            ],
            "properties": {
              "children": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/layer"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "instance"
              }
            }
          },
          "then": {
            "required": [
              "instance_source"
            ],
            "properties": {
              "instance_source": {
                "$ref": "#/$defs/nodePointer"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stack": {
      "type": "object",
      "required": [
        "name",
        "channels",
        "root_layers"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "channels": {
          "description": "At most one channel per ChannelType: the type is the key.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/channelType"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "format",
              "base"
            ],
            "properties": {
              "format": {
                "$ref": "#/$defs/channelFormat"
              },
              "base": {
                "description": "The float32 backdrop the evaluator reads for this channel: the template's base value, else the channel default.",
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            },
            "unevaluatedProperties": false
          }
        },
        "root_layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "meshMapBinding": {
      "type": "object",
      "required": [
        "resource",
        "format",
        "color_space",
        "provenance",
        "invalid"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "$ref": "#/$defs/channelFormat"
        },
        "color_space": {
          "type": "string"
        },
        "provenance": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "declared_convention"
              ],
              "properties": {
                "kind": {
                  "const": "imported"
                },
                "declared_convention": {
                  "$ref": "#/$defs/normalMapFormat"
                }
              },
              "unevaluatedProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "baked"
                }
              },
              "unevaluatedProperties": false
            }
          ]
        },
        "invalid": {
          "type": "boolean"
        }
      },
      "unevaluatedProperties": false
    },
    "textureSet": {
      "type": "object",
      "required": [
        "name",
        "original_name",
        "material_id",
        "resolution",
        "uv_tiles",
        "mesh_maps",
        "stacks"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmpty"
        },
        "original_name": {
          "type": "string"
        },
        "material_id": {
          "type": "string"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        },
        "uv_tiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "udim"
            ],
            "properties": {
              "udim": {
                "type": "integer",
                "minimum": 1001,
                "maximum": 2000
              }
            },
            "unevaluatedProperties": false
          }
        },
        "mesh_maps": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/meshMapUsage"
          },
          "additionalProperties": {
            "$ref": "#/$defs/meshMapBinding"
          }
        },
        "height_to_normal_method": {
          "enum": [
            "Sharp",
            "SmoothSobel"
          ]
        },
        "stacks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stack"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "nodePointer": {
      "description": "A node of the same texture set, as a JSON pointer into the recipe's texture set object.",
      "type": "string",
      "pattern": "^/stacks/[0-9]+/root_layers/[0-9]+(/children/[0-9]+)*(/(content_effects|mask/effects)/[0-9]+)?$"
    },
    "planeContent": {
      "description": "A paint plane: the chunk root of its bound version (src/store/planes.h), null when none is bound.",
      "type": "object",
      "required": [
        "chunk_root"
      ],
      "properties": {
        "chunk_root": {
          "$ref": "#/$defs/optionalSha256"
        }
      },
      "unevaluatedProperties": false
    },
    "recipe": {
      "description": "The body: every output-determining field of the revision, and only those (src/uzp_core/manifest/recipe.h).",
      "type": "object",
      "required": [
        "evaluator_profile",
        "settings",
        "mesh",
        "texture_sets",
        "resources"
      ],
      "properties": {
        "evaluator_profile": {
          "$ref": "#/$defs/nonEmpty"
        },
        "settings": {
          "type": "object",
          "required": [
            "normal_map_format",
            "tangent_space",
            "workflow",
            "color_management",
            "template"
          ],
          "properties": {
            "normal_map_format": {
              "$ref": "#/$defs/normalMapFormat"
            },
            "tangent_space": {
              "enum": [
                "PerVertex",
                "PerFragment"
              ]
            },
            "workflow": {
              "enum": [
                "Default",
                "UVTile",
                "TextureSetPerUVTile"
              ]
            },
            "color_management": {
              "type": "object",
              "required": [
                "mode",
                "config_hash",
                "working_space",
                "io_rules"
              ],
              "properties": {
                "mode": {
                  "type": "string"
                },
                "config_hash": {
                  "anyOf": [
                    {
                      "const": ""
                    },
                    {
                      "$ref": "#/$defs/sha256"
                    }
                  ]
                },
                "working_space": {
                  "type": "string"
                },
                "io_rules": {
                  "type": "array"
                }
              },
              "unevaluatedProperties": false
            },
            "template": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "unevaluatedProperties": false
        },
        "mesh": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "resource",
                "import_report"
              ],
              "properties": {
                "resource": {
                  "$ref": "#/$defs/sha256"
                },
                "import_report": {
                  "type": "object"
                }
              },
              "unevaluatedProperties": false
            }
          ]
        },
        "texture_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textureSet"
          }
        },
        "resources": {
          "description": "The resources the body references, by SHA-256.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/sha256"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "mime",
              "size"
            ],
            "properties": {
              "mime": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            },
            "unevaluatedProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    }
  }
}
