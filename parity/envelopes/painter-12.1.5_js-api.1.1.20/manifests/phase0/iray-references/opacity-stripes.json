  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "sphere"
        }
      },
      {
        "step": 2,
        "call": "substance_painter.display.Camera.projection_type",
        "args": {
          "value": "Perspective"
        }
      },
      {
        "step": 3,
        "call": "substance_painter.display.Camera.position",
        "args": {
          "value": [
            0.0,
            0.0,
            60.0
          ]
        }
      },
      {
        "step": 4,
        "call": "substance_painter.display.Camera.rotation",
        "args": {
          "value": [
            0.0,
            0.0,
            0.0
          ]
        }
      },
      {
        "step": 5,
        "call": "substance_painter.display.Camera.field_of_view",
        "args": {
          "value": 40.0
        }
      },
      {
        "step": 6,
        "call": "substance_painter.display.Camera.aperture",
        "args": {
          "value": 0.0
        }
      },
      {
        "step": 7,
        "call": "substance_painter.display.set_environment_resource",
        "args": {
          "resource_url": "resource://starter_assets/Studio White Soft?version=022c26ec30cd5575037b74f697993c1d73f52865.image"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.textureset.Stack.add_channel",
        "args": {
          "channel": "Opacity",
          "format": "L8"
        }
      },
      {
        "step": 9,
        "call": "substance_painter.resource.import_project_resource",
        "args": {
          "input": "opacity-stripes",
          "usage": "TEXTURE"
        }
      },
      {
        "step": 10,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top"
        }
      },
      {
        "step": 11,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 10,
          "channels": [
            "BaseColor",
            "BaseMetalness",
            "SpecularRoughness",
            "Opacity"
          ]
        }
      },
      {
        "step": 12,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 10,
          "channel": "BaseColor",
          "color": [
            0.5,
            0.5,
            0.5
          ],
          "color_space": "sRGB"
        }
      },
      {
        "step": 13,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 10,
          "channel": "BaseMetalness",
          "color": [
            0.0,
            0.0,
            0.0
          ],
          "color_space": "Raw"
        }
      },
      {
        "step": 14,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 10,
          "channel": "SpecularRoughness",
          "color": [
            0.5,
            0.5,
            0.5
          ],
          "color_space": "Raw"
        }
      },
      {
        "step": 15,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 10,
          "channel": "Opacity",
          "resource_step": 9
        }
      }
    ]
