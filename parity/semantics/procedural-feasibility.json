    {
      "entry_id": "metal-edge-wear-prototype",
      "subject": "Metal Edge Wear (mesh-map generators), feasibility prototype",
      "status": "calibrated",
      "formula": "e = Gaussian blur, sigma = blur_sigma * Edges Smoothness, of 2 max(curvature - 1/2, 0); n = fBm(Grunge Scale cells, seed) in [0, 1]; w = edge_gain * Curvature Weight * e + grunge_gain * Grunge Amount * (n - 1/2) + bias; out = clamp((w - (1 - Wear Level)) * (1 + contrast_gain * Wear Contrast) + 1/2) * (1 - m + m * AO), m = Ambient Occlusion Masking.",
      "public_sources": [
        {
          "source_id": "A-HELP-GUIDE",
          "locator": "Effects > Generators > Metal Edge Wear (parameters)"
        },
        {
