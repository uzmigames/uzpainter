    {
      "entry_id": "mask-precision",
      "subject": "Mask stacks: background, a bitmap fill effect and its opacity, mask storage precision",
      "status": "exact",
      "formula": "m := background (White 1, Black 0); each visible mask effect bottom-up: a fill effect m := m + (r - m) alpha with r = kernel(mode, m, b) clamped to [0, 1], b the source's mono value and alpha the effect's opacity; m is stored at 16 bits (the UNORM write rule) after every effect on every channel format; the layer blends with opacity x m (a disabled or absent mask counts as 1).",
      "public_sources": [
        {
          "source_id": "A-PYDOC",
          "locator": "substance_painter.layerstack: LayerNode.add_mask, MaskBackground, insert_fill (mask and content stacks), FillEffectNode, LevelsEffectNode and its parameters, Node.set_blending_mode"
        },
        {
          "source_id": "A-HELP-GUIDE",
          "locator": "Masks, fill and levels effects, blending modes"
        },
        {
          "source_id": "X-D3D12",
          "locator": "Floating-point rules: rcp within 1 ULP, log2 / exp2 approximations, FLOAT to UNORM"
        }
      ],
      "parameters": [
        {
          "name": "mask_bits",
          "value": 16,
          "origin": "fitted"
        },
        {
          "name": "write_rule",
          "value": "UNORM16, n + 4 fractional bits, ties down",
          "origin": "fitted"
        }
      ],
