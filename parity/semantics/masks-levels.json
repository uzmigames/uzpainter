    {
      "entry_id": "content-effect-order",
      "subject": "Content effects in list order (fill effect and levels)",
      "status": "gap",
      "formula": "Content effects run bottom-up in list order on the layer's own content for the channel, the content stored in the channel format after each effect: a fill effect blends its source for the channel with its per-channel mode and opacity through the effect mix, a levels effect remaps its affected channel only.",
      "public_sources": [
