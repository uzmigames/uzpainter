{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/api-probes/phase1-reload-resources",
  "tier": "0",
  "domain": "tier0/api-probes/phase1-reload-resources",
  "description": "API probe (R10): resource.reload_modified_resources_async after the imported bitmap's file was rewritten (mask_left_half -> checker bytes), then once more with nothing modified; ReloadResourcesStarted / ReloadResourcesEnded, is_reload_modified_resources_running() and the fill's bitmap binding, in both recordings, with the BaseColor export.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    },
    {
      "input_id": "mask_left_half",
      "kind": "image",
      "path": "parity/fixtures/api-probes/mask-left-half.png",
      "sha256": "f5d8e7f1c0bc3b577833422141afee43682f1b1fe28696e51de48e3031ccc724",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0",
        "note": "16x16 8-bit grey: left half 255, right half 0."
      }
    },
    {
      "input_id": "checker",
      "kind": "image",
      "path": "parity/fixtures/api-probes/checker-16.png",
      "sha256": "4d1acf002ea180ad1af069b24c114ac41f58784b347174251b665673d7330126",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0",
        "note": "16x16 8-bit RGB checker of 4x4 cells, (204,51,26) and (26,128,204)."
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.event.Dispatcher.connect",
        "args": {
          "events": [
            "ReloadResourcesStarted",
            "ReloadResourcesEnded",
            "BusyStatusChanged",
            "LayerStacksModelDataChanged"
          ]
        }
      },
      {
        "step": 3,
        "call": "substance_painter.resource.import_project_resource",
        "args": {
          "image": "mask_left_half",
          "usage": "TEXTURE"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top"
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 4,
          "channels": [
            "BaseColor"
          ]
        }
      },
      {
        "step": 6,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 4,
          "channel": "BaseColor",
          "resource_step": 3
        }
      },
      {
        "step": 7,
        "call": "substance_painter.layerstack.FillLayerNode.get_source",
        "args": {
          "node_step": 4,
          "channel": "BaseColor"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.resource.is_reload_modified_resources_running"
      },
      {
        "step": 9,
        "call": "substance_painter.resource.reload_modified_resources_async",
        "args": {
          "filter": "ResourcesUsedByProjectFilter",
          "rewrite_input": "mask_left_half",
          "with_input": "checker",
          "probe": true
        }
      },
      {
        "step": 10,
        "call": "substance_painter.resource.is_reload_modified_resources_running"
      },
      {
        "step": 11,
        "call": "substance_painter.layerstack.FillLayerNode.get_source",
        "args": {
          "node_step": 4,
          "channel": "BaseColor"
        }
      },
      {
        "step": 12,
        "call": "substance_painter.resource.reload_modified_resources_async",
        "args": {
          "filter": "ProjectFilter",
          "probe": true
        }
      },
      {
        "step": 13,
        "call": "substance_painter.layerstack.FillLayerNode.get_source",
        "args": {
          "node_step": 4,
          "channel": "BaseColor"
        }
      },
      {
        "step": 14,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "infinite",
          "dithering": false
        }
      }
    ]
  },
  "applied_settings": [
    {
      "name": "project.normal_map_format",
      "value": "OpenGL",
      "applied_by": "recorder_api"
    },
    {
      "name": "texture_set.resolution",
      "value": 256,
      "unit": "px",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.file_format",
      "value": "png",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.bit_depth",
      "value": 16,
      "applied_by": "recorder_api"
    },
    {
      "name": "export.padding",
      "value": "infinite",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.dithering",
      "value": false,
      "applied_by": "recorder_api"
    }
  ],
  "expectations": [],
  "software": {
    "painter": {
      "product": "Adobe Substance 3D Painter",
      "version": "12.1.5",
      "build_id": "12.1.5+js-api.1.1.20"
    },
    "uzpainter_build_hash": null
  },
  "private_records": [
