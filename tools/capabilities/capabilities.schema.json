{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uzpainter/capabilities/1",
  "title": "UzPainter capability manifest (capabilities.json)",
  "description": "One entry per qualified symbol and operation context (docs/architecture/10-python-api.md §3). Generated by tools/capabilities/generate_capabilities.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "compat_profile", "documentation", "entries", "operation_matrix"],
  "properties": {
    "schema": { "const": "uzpainter/capabilities/1" },
    "compat_profile": { "type": "string", "pattern": "^painter-[0-9]+\\.[0-9]+-api-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "documentation": { "type": "string", "minLength": 1 },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "operation_matrix": {
      "description": "The requirement-to-typed-operation matrix (docs/architecture/11-mcp-server.md §2; decision 182): one row per required operation.",
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "requirements", "tool", "fixture", "status", "gaps", "notes"],
      "properties": {
        "operation": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{2}$" },
          "contains": { "enum": ["INT-02", "ARC-14"] }
        },
        "tool": { "description": "The typed MCP tool; null when none exists.", "type": ["string", "null"] },
        "fixture": {
          "description": "The Python-disabled conformance fixture (a pytest node id).",
          "type": ["string", "null"],
          "pattern": "^tests/[A-Za-z0-9_/]+\\.py::test_[A-Za-z0-9_]+$"
        },
        "status": { "enum": ["available", "capability gap", "needs Python"] },
        "gaps": {
          "description": "The operations the call performs that are release gaps or unlisted in the manifest.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "context", "status"],
            "properties": {
              "symbol": { "type": "string" },
              "context": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        },
        "notes": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } } },
          "then": { "properties": { "tool": { "type": "string" }, "fixture": { "type": "string" }, "gaps": { "maxItems": 0 } } },
          "else": { "properties": { "notes": { "type": "string", "pattern": "phase[0-9]+\\.[0-9]+_[a-z0-9-]+" } } }
        },
        {
          "if": { "properties": { "tool": { "const": "run_python" } } },
          "then": { "properties": { "status": { "const": "needs Python" } } }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "context", "status", "since", "tier_evidence", "notes", "evidence"],
      "properties": {
        "symbol": {
          "description": "Qualified Python name: a documented Painter symbol (substance_painter, substance_painter_plugins) or a UzPainter addition (uzpainter).",
          "type": "string",
          "pattern": "^(substance_painter|substance_painter_plugins|uzpainter)(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "not": { "pattern": "[Ss][Tt][Rr][Oo][Kk][Ee]" }
        },
        "context": {
          "description": "Operation context: 'any', or a narrower one such as 'mask-stack', 'file-format:tiff' or 'mode:painter_iray'.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.:-]*$",
          "not": { "pattern": "[Ss][Tt][Rr][Oo][Kk][Ee]" }
        },
        "status": { "enum": ["supported", "desktop-only-omitted", "release-gap", "pending-evidence"] },
        "since": {
          "description": "UzPainter version that first supports the entry; null unless supported.",
          "type": ["string", "null"],
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "tier_evidence": {
          "description": "Golden ids of Tier 0 public manifests (parity/manifests/tier0/).",
          "type": "array",
          "items": { "type": "string", "pattern": "^tier0/[a-z0-9._/-]+$" }
        },
        "notes": { "type": ["string", "null"], "minLength": 1 },
        "evidence": {
          "description": "Documentation anchors (python-doc/<page>#<anchor> for Painter symbols, docs/<file>.md#<heading> for additions) and other evidence references.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "supported" } } },
          "then": { "properties": { "since": { "type": "string" }, "tier_evidence": { "minItems": 1 } } },
          "else": { "properties": { "since": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "desktop-only-omitted" } } },
          "then": { "properties": { "notes": { "type": "string" } } }
        },
        {
          "if": { "properties": { "status": { "const": "pending-evidence" } } },
          "then": { "properties": { "notes": { "type": "string" }, "tier_evidence": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "symbol": { "pattern": "^substance_painter" } } },
          "then": {
            "properties": {
              "evidence": { "contains": { "pattern": "^python-doc/[A-Za-z0-9_/]+\\.html(#[A-Za-z0-9_.-]+)?$" } }
            }
          }
        }
      ]
    }
  }
}
