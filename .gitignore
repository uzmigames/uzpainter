# Rulebook - ignore runtime data, keep specs, tasks and project memory
/.rulebook/*
!/.rulebook/specs/
!/.rulebook/tasks/
!/.rulebook/archive/
!/.rulebook/decisions/
!/.rulebook/knowledge/
!/.rulebook/learnings/
!/.rulebook/rulebook.json

# Patterns added by @hivellm/rulebook
