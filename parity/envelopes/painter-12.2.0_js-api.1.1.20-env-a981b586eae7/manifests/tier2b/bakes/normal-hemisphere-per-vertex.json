      }
    },
    {
      "input_id": "hemisphere-high",
      "kind": "mesh",
      "path": "parity/fixtures/normal-convention/hemisphere-high.obj",
      "sha256": "113ff886854cb4638dea059ed47ddb5c66db704499a8aa17135813782200284f",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "hemisphere-low",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 512,
          "tangent_space_mode": "PerVertex"
        }
      },
      {
        "step": 2,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "OutputSize",
          "value": [
            9,
            9
          ]
        }
      },
      {
        "step": 3,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "DilationWidth",
          "value": 0
        }
      },
      {
        "step": 4,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "RelativeScale",
          "value": false
        }
      },
      {
        "step": 5,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "MaxHeight",
          "value": 0.02
        }
      },
      {
        "step": 6,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "MaxDepth",
          "value": 0.02
        }
      },
      {
        "step": 7,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "HipolyMesh",
          "input": "hemisphere-high"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.baking.BakingParameters.set_enabled_bakers",
        "args": {
          "usages": [
            "Normal"
          ]
        }
      },
      {
        "step": 9,
        "call": "substance_painter.baking.bake_async",
        "args": {}
      },
      {
        "step": 10,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "meshMap/normal_base:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "passthrough",
          "dithering": false
        }
      },
      {
        "step": 11,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "meshMap/normal_base:RGB"
          ],
          "file_format": "exr",
          "bit_depth": "32f",
          "padding": "passthrough",
          "dithering": false
        }
      }
    ]
  },
