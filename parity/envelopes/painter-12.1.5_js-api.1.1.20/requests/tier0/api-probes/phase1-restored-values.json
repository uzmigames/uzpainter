        "step": 20,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 21,
        "call": "substance_painter.layerstack.Node.set_name",
        "args": {
          "node_step": 3,
          "name": "uzp fill B",
          "probe": true
        }
      },
      {
        "step": 22,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 23,
        "call": "substance_painter.layerstack.Node.set_opacity",
        "args": {
          "node_step": 3,
          "opacity": 0.5,
          "channel": "BaseColor",
          "probe": true
        }
      },
      {
        "step": 24,
        "call": "substance_painter.project.needs_saving",
        "args": {}
      },
      {
        "step": 25,
        "call": "substance_painter.layerstack.Node.set_name",
        "args": {
          "node_step": 3,
          "name": "uzp fill A",
