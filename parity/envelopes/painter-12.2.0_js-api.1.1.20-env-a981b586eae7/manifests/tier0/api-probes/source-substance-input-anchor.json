  "domain": "tier0/api-probes/source-substance-input-anchor",
  "description": "The decision-412 starter material's first image input (chosen in Painter) set to an anchor point inside a paint layer below the fill, then reset, with get_source and get_parameters after each, repeated after save/reopen. No asset parameter or input name is authored.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
