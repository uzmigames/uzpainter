      },
      {
        "step": 3,
        "call": "substance_painter.resource.import_project_resource",
        "args": {
          "image": "mask_left_half",
          "usage": "TEXTURE"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top"
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 4,
          "channels": [
            "BaseColor"
          ]
        }
      },
      {
        "step": 6,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 4,
          "channel": "BaseColor",
          "color": [
            0.5,
            0.25,
            0.75
          ],
          "color_space": "Working"
        }
      },
      {
        "step": 7,
        "call": "substance_painter.layerstack.LayerNode.add_mask",
        "args": {
          "node_step": 4,
          "background": "Black"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.layerstack.insert_levels_effect",
        "args": {
          "inside_step": 4,
          "node_stack": "Content"
        }
      },
      {
        "step": 9,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "below_step": 4
        }
      },
      {
        "step": 10,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 9,
          "channels": [
            "BaseColor"
          ]
