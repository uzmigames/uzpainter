{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uzpainter:parity:schema:snapshot-producer-policy:1",
  "title": "Public snapshot producer policy",
  "description": "Reviewed source identities only; no capture bytes, paths or execution attestation. Exact integer revision and duplicate producer pairs are also checked by the structural parser.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "producers"],
  "properties": {
    "schema": {"const": "uzpainter/parity/snapshot-producer-policy/1"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "producers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol", "source_revision", "bridge_sha256", "painter_side_sha256"],
        "properties": {
          "protocol": {"const": "paired-scalar-rgb"},
          "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "bridge_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "painter_side_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
