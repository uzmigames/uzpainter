      "sha256": "b4737da6cb10fdaa4749a58342d5f0a48be39159e5c2bddce2906c3da8182889",
      "size_bytes": 18515
    },
    {
      "record_id": "r1-uzp_plane-basecolor",
      "kind": "exported_map",
      "sha256": "3901718d3ecae40616f1aa3857ccc11dcd0bd382313bf4aac24ce12f1153110e",
      "size_bytes": 1013
    },
    {
      "record_id": "r2-uzp_plane-basecolor",
