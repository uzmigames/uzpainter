{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier2b/bakes/curvature-sphere-from-normal-map",
  "tier": "2b",
  "domain": "bake_map/curvature",
  "description": "Tier 2b bake golden of phase3.4_baker-curvature (decision 384) on the analytic fixture sphere: the sphere on its ground, baked low as high. Painter bakes Normal and Curvature at 512 px (OutputSize 9, DilationWidth 0, LowAsHigh True; CurvatureMethod FromNormalMap; every other baking parameter at Painter's default; normal map format OpenGL, tangent space the project default). The baked maps are exported as PNG 16 and OpenEXR 32f, padding passthrough, no dithering; recorded twice (same session; after save and reopen). Bake backend uncontrolled.",
  "inputs": [
    {
      "input_id": "sphere-on-ground",
      "kind": "mesh",
      "path": "parity/fixtures/tier2b-bakes/sphere-on-ground.obj",
      "sha256": "19770be3cd3aa8a5ce1578be6dff4caef990f39a28019b79ff062ccd0ba42e96",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "sphere-on-ground",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 512
        }
      },
      {
        "step": 2,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "OutputSize",
          "value": [
            9,
            9
          ]
        }
      },
      {
        "step": 3,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "DilationWidth",
          "value": 0
        }
      },
      {
        "step": 4,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "LowAsHigh",
          "value": true
        }
      },
      {
        "step": 5,
        "call": "substance_painter.baking.BakingParameters.set_curvature_method",
        "args": {
          "method": "FromNormalMap"
        }
      },
      {
        "step": 6,
        "call": "substance_painter.baking.BakingParameters.set_enabled_bakers",
        "args": {
          "usages": [
            "Normal",
            "Curvature"
          ]
        }
      },
      {
        "step": 7,
        "call": "substance_painter.baking.bake_async",
        "args": {}
      },
      {
        "step": 8,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "meshMap/normal_base:RGB",
            "meshMap/curvature:L"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "passthrough",
          "dithering": false
        }
      },
      {
        "step": 9,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "meshMap/normal_base:RGB",
            "meshMap/curvature:L"
          ],
          "file_format": "exr",
          "bit_depth": "32f",
          "padding": "passthrough",
          "dithering": false
        }
      }
    ]
  },
  "applied_settings": [
    {
      "name": "project.normal_map_format",
      "value": "OpenGL",
      "applied_by": "recorder_api"
    },
    {
      "name": "texture_set.resolution",
