          "usage": "TEXTURE"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.textureset.TextureSet.set_mesh_map_resource",
        "args": {
          "usage": "Position",
          "resource_step": 2
        }
      },
      {
        "step": 9,
        "call": "substance_painter.textureset.TextureSet.set_mesh_map_resource",
        "args": {
          "usage": "WorldSpaceNormal",
          "resource_step": 3
        }
      },
      {
        "step": 10,
        "call": "substance_painter.textureset.TextureSet.set_mesh_map_resource",
        "args": {
          "usage": "Normal",
          "resource_step": 4
        }
      },
      {
        "step": 11,
        "call": "substance_painter.textureset.TextureSet.set_mesh_map_resource",
        "args": {
          "usage": "AO",
          "resource_step": 5
        }
      },
      {
        "step": 12,
        "call": "substance_painter.textureset.TextureSet.set_mesh_map_resource",
        "args": {
          "usage": "Curvature",
          "resource_step": 6
        }
      },
      {
        "step": 13,
        "call": "substance_painter.textureset.TextureSet.set_mesh_map_resource",
        "args": {
          "usage": "Thickness",
          "resource_step": 7
        }
      },
      {
        "step": 14,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top"
        }
      },
      {
        "step": 15,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 14,
          "channels": [
            "Height"
          ]
        }
      },
      {
        "step": 16,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 14,
          "channel": "Height",
          "color": [
            0.0,
            0.0,
            0.0
          ],
          "color_space": "Raw"
        }
      },
      {
        "step": 17,
        "call": "substance_painter.layerstack.insert_smart_material",
        "args": {
          "above_step": 14,
          "resource_name": "Leather Damaged",
          "resource_usage": "SMART_MATERIAL"
        }
      },
      {
        "step": 18,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB",
            "documentMap/specularroughness:L",
            "documentMap/basemetalness:L",
            "documentMap/height:L",
            "documentMap/normal:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "passthrough",
          "dithering": false
        }
      }
    ]
