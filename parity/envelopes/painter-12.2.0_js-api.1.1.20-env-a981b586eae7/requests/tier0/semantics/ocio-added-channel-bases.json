  "domain": "tier0/stack/base-values",
  "description": "Empty-channel bases under OCIO (phase3.2_unreal-ue56-packed-preset item 2.5, decision 422): an empty plane at 256 px, no template (the default project's channels), under OCIO with Painter's substance configuration, with Opacity freshly added as L8 and EmissionColor as sRGB8, as R-322's OCIO session adds them; no layer, no source. Export documentMap/opacity:L and documentMap/emissive:RGB twice as OpenEXR 32f and twice as PNG 16, infinite padding, no dithering; the recorder repeats every export after save and reopen. No base is presumed; other channels, formats and templates are not covered.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.textureset.Stack.add_channel",
        "args": {
          "channel": "Opacity",
          "format": "L8"
        }
      },
      {
        "step": 3,
        "call": "substance_painter.textureset.Stack.add_channel",
        "args": {
          "channel": "EmissionColor",
          "format": "sRGB8"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/opacity:L",
            "documentMap/emissive:RGB"
          ],
          "file_format": "exr",
          "bit_depth": "32f",
          "padding": "infinite",
          "dithering": false
        }
      },
      {
        "step": 5,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
