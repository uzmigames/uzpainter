{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier0/api-probes/ocio16-bitmap-srgb-basecolor-uniform",
  "tier": "0",
  "domain": "tier0/api-probes/ocio16-input",
  "description": "Isolated OCIO Substance-config input control: uniform, into BaseColor sRGB8 on the authored 256px full-UV plane. Bitmap inputs use the explicit literal configuration string sRGB, not a generic enum; the uniform uses Working (0, 0.5, 1). Nearest identity UV, Normal opacity 1. Setup runs once. Read the typed bitmap space (or uniform source) before PNG8, PNG16 and EXR32f capture exports, with no dithering or padding. Full save/reopen repeats that getter before exports, without any setter. Five independent controls total 15 exported maps per repetition. Measures the composite input-to-sRGB8 path, not a full-precision decoder; no fit, preset parity or capability promotion.",
  "inputs": [
    {
      "input_id": "plane",
      "kind": "mesh",
      "path": "parity/fixtures/meshes/plane.obj",
      "sha256": "7d3c5f616c2abf4b06050434fa943d19dcb15ec998245a211d1d4ca7e95197fe",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 256
        }
      },
      {
        "step": 2,
        "call": "substance_painter.textureset.Stack.edit_channel",
        "args": {
          "channel": "BaseColor",
          "format": "sRGB8"
        }
      },
      {
        "step": 3,
        "call": "substance_painter.layerstack.insert_fill",
        "args": {
          "position": "top",
          "texture_set": "uzp_plane"
        }
      },
      {
        "step": 4,
        "call": "substance_painter.layerstack.FillLayerNode.active_channels",
        "args": {
          "node_step": 3,
          "channels": [
            "BaseColor"
          ]
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.Node.set_blending_mode",
        "args": {
          "node_step": 3,
          "blending_mode": "Normal",
          "channel": "BaseColor"
        }
      },
      {
        "step": 6,
        "call": "substance_painter.layerstack.Node.set_opacity",
        "args": {
          "node_step": 3,
          "opacity": 1.0,
          "channel": "BaseColor"
        }
      },
      {
        "step": 7,
        "call": "substance_painter.layerstack.FillLayerNode.set_projection_mode",
        "args": {
          "node_step": 3,
          "projection_mode": "UV"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.layerstack.FillLayerNode.set_projection_parameters",
        "args": {
          "node_step": 3,
          "filtering_mode": "Nearest",
          "uv_wrapping_mode": "Repeat",
          "scale_mode": "Factors",
          "scale": [
            1.0,
            1.0
          ],
          "rotation": 0.0,
          "offset": [
            0.0,
            0.0
          ]
        }
      },
      {
        "step": 9,
        "call": "substance_painter.layerstack.FillLayerNode.set_source",
        "args": {
          "node_step": 3,
          "channel": "BaseColor",
          "color": [
            0.0,
            0.5,
            1.0
          ],
          "color_space": "Working"
        }
      },
      {
        "step": 10,
        "call": "substance_painter.layerstack.FillLayerNode.get_source",
        "args": {
          "node_step": 3,
          "channel": "BaseColor"
        }
      },
      {
        "step": 11,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB"
          ],
          "file_format": "png",
          "bit_depth": 8,
          "padding": "passthrough",
          "dithering": false,
          "key_by_step": true
        }
      },
      {
        "step": 12,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "passthrough",
          "dithering": false,
          "key_by_step": true
        }
      },
      {
        "step": 13,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "documentMap/basecolor:RGB"
          ],
          "file_format": "exr",
          "bit_depth": "32f",
          "padding": "passthrough",
          "dithering": false,
          "key_by_step": true
        }
      }
    ]
  },
  "applied_settings": [
    {
      "name": "project.normal_map_format",
      "value": "OpenGL",
      "applied_by": "recorder_api"
    },
    {
      "name": "texture_set.resolution",
      "value": 256,
      "unit": "px",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.png.bit_depth",
      "value": 8,
      "applied_by": "recorder_api"
    },
    {
      "name": "export.padding",
      "value": "passthrough",
      "applied_by": "recorder_api"
    },
    {
      "name": "export.dithering",
      "value": false,
      "applied_by": "recorder_api"
    },
    {
      "name": "export.png.bit_depth",
      "value": 16,
      "applied_by": "recorder_api"
    },
    {
      "name": "export.exr.bit_depth",
      "value": "32f",
      "applied_by": "recorder_api"
    },
    {
      "name": "OCIO",
      "value": "resources/ocio/substance/config.ocio",
      "applied_by": "environment_variable"
    }
  ],
