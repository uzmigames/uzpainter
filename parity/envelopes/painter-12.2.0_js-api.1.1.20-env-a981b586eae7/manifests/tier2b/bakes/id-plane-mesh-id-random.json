{
  "schema": "uzpainter/parity/golden-public/1",
  "record_class": "public_manifest",
  "golden_id": "tier2b/bakes/id-plane-mesh-id-random",
  "tier": "2b",
  "domain": "bake_map/id",
  "description": "Tier 2b bake golden of phase3.4_baker-id (decision 384) on the analytic fixture plane: the low plane under a wider flat high 0.005 above it (CaseNormalPlane). Painter bakes ID at 512 px (OutputSize 9, DilationWidth 0, RelativeScale False, MaxHeight 0.05, MaxDepth 0.05; ID ColorSource Mesh ID / Polygroup, ID ColorGenerator Random; every other baking parameter at Painter's default; normal map format OpenGL, tangent space the project default). The baked maps are exported as PNG 16 and OpenEXR 32f, padding passthrough, no dithering; recorded twice (same session; after save and reopen). Bake backend uncontrolled.",
  "inputs": [
    {
      "input_id": "plane-low",
      "kind": "mesh",
      "path": "parity/fixtures/tier2b-bakes/plane-low.obj",
      "sha256": "68827bcbe48df255d230687d9041f6f146dc4ed4787ce1bcdc42bbb914619dc2",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    },
    {
      "input_id": "plane-high",
      "kind": "mesh",
      "path": "parity/fixtures/tier2b-bakes/plane-high.obj",
      "sha256": "5da4a5d58e25a85ca0e7fff77894db77f1291773206031bb0d70e69e47003ff4",
      "provenance": {
        "origin": "uzmigames_authored",
        "licence": "Apache-2.0"
      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "plane-low",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 512
        }
      },
      {
        "step": 2,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "OutputSize",
          "value": [
            9,
            9
          ]
        }
      },
      {
        "step": 3,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "DilationWidth",
          "value": 0
        }
      },
      {
        "step": 4,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "RelativeScale",
          "value": false
        }
      },
      {
        "step": 5,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "MaxHeight",
          "value": 0.05
        }
      },
      {
        "step": 6,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "MaxDepth",
          "value": 0.05
        }
      },
      {
        "step": 7,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "HipolyMesh",
          "input": "plane-high"
        }
      },
      {
        "step": 8,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "ColorSource",
          "usage": "ID",
          "enum_label": "Mesh ID / Polygroup"
        }
      },
      {
        "step": 9,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "ColorGenerator",
          "usage": "ID",
          "enum_label": "Random"
        }
      },
      {
        "step": 10,
        "call": "substance_painter.baking.BakingParameters.set_enabled_bakers",
        "args": {
          "usages": [
            "ID"
          ]
        }
      },
      {
        "step": 11,
        "call": "substance_painter.baking.bake_async",
        "args": {}
      },
      {
        "step": 12,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "meshMap/id:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "passthrough",
          "dithering": false
        }
      },
      {
        "step": 13,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "meshMap/id:RGB"
          ],
          "file_format": "exr",
          "bit_depth": "32f",
          "padding": "passthrough",
          "dithering": false
        }
      }
    ]
  },
