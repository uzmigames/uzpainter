      }
    }
  ],
  "instruction_sequence": {
    "author": "UzmiGames",
    "interface": "substance_painter_documented_python_api",
    "steps": [
      {
        "step": 1,
        "call": "substance_painter.project.create",
        "args": {
          "mesh": "bevelled-cube-low",
          "normal_map_format": "OpenGL",
          "default_texture_resolution": 512
        }
      },
      {
        "step": 2,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "OutputSize",
          "value": [
            9,
            9
          ]
        }
      },
      {
        "step": 3,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "DilationWidth",
          "value": 0
        }
      },
      {
        "step": 4,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "FilterMethod",
          "enum_label": "By mesh name"
        }
      },
      {
        "step": 5,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "RelativeScale",
          "value": false
        }
      },
      {
        "step": 6,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "MaxHeight",
          "value": 0.05
        }
      },
      {
        "step": 7,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "MaxDepth",
          "value": 0.04
        }
      },
      {
        "step": 8,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "HipolyMesh",
          "input": "bevelled-cube-high"
        }
      },
      {
        "step": 9,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "Mode",
          "usage": "Position",
          "enum_label": "All axis"
        }
      },
      {
        "step": 10,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "Normalization",
          "usage": "Position",
          "enum_label": "BBox"
        }
      },
      {
        "step": 11,
        "call": "substance_painter.baking.BakingParameters.set",
        "args": {
          "parameter": "NormalizationScale",
          "usage": "Position",
          "enum_label": "Per Material"
        }
      },
      {
        "step": 12,
        "call": "substance_painter.baking.BakingParameters.set_enabled_bakers",
        "args": {
          "usages": [
            "Position"
          ]
        }
      },
      {
        "step": 13,
        "call": "substance_painter.baking.bake_async",
        "args": {}
      },
      {
        "step": 14,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "meshMap/position:RGB"
          ],
          "file_format": "png",
          "bit_depth": 16,
          "padding": "passthrough",
          "dithering": false
        }
      },
      {
        "step": 15,
        "call": "substance_painter.export.export_project_textures",
        "args": {
          "maps": [
            "meshMap/position:RGB"
          ],
          "file_format": "exr",
          "bit_depth": "32f",
          "padding": "passthrough",
          "dithering": false
        }
      }
    ]
