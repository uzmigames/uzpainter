*.log
*.swo
*.swp
*~
.DS_Store
.cache/
.env
.env.*.local
.env.local
.idea/
.vscode/
Thumbs.db
logs/
temp/
tmp/

CLAUDE.local.md
.rulebook/backup/

# Python bytecode and tool caches
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
