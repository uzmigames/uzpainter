      },
      {
        "step": 4,
        "call": "substance_painter.layerstack.Node.set_name",
        "args": {
          "node_step": 3,
          "name": "uzp fill"
        }
      },
      {
        "step": 5,
        "call": "substance_painter.layerstack.insert_paint",
        "args": {
