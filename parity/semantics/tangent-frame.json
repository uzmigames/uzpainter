    {
      "entry_id": "no-hit-texels",
      "subject": "Texels whose bake ray hits no high-poly triangle (plane-dome pair)",
      "status": "exact",
      "formula": "A texel inside the low UV triangles whose ray hits no high triangle is left empty: code 0 in every channel. The bake's dilation (DilationWidth, default 32 px) then fills empty texels near hit texels; only texels more than 40 texels from every hit texel are compared.",
      "public_sources": [
        {
          "source_id": "A-PYDOC",
